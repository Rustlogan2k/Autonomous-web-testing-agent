{
  "app_id": "quizcraft",
  "name": "Quizcraft",
  "domain": "questionnaire authoring: a cycling club secretary edits the members' annual survey",
  "user_goal": "Edit the survey's questions, required flags and skip logic, preview it as a member would answer it, undo and redo edits, and save revisions.",
  "architecture": "client-command-stack-editor+revisioned-document-api",
  "stack": "python-stdlib(http.server)+sqlite",
  "persistence": "sqlite, append-only table of saved revisions per session; the working copy and undo/redo stacks live only in page memory",
  "entry": "/quiz",
  "start": ["python", "src/server.py"],
  "dockerfile": false,
  "workflow_graph": {
    "kind": ["editor-loop", "nested-form", "revisit"],
    "nodes": ["editor", "editor:inspector", "editor:logic-panel", "editor:add-menu", "preview", "preview:end",
              "history", "revisions", "help"],
    "edges": [["editor", "editor:inspector"], ["editor:inspector", "editor:inspector"],
              ["editor:inspector", "editor:logic-panel"], ["editor:logic-panel", "editor:inspector"],
              ["editor", "editor:add-menu"], ["editor:add-menu", "editor:inspector"], ["editor:inspector", "editor"],
              ["editor", "preview"], ["editor:inspector", "preview"], ["preview", "preview"], ["preview", "preview:end"],
              ["preview:end", "preview"], ["preview", "editor"], ["preview:end", "editor"], ["editor", "history"],
              ["history", "editor"], ["history", "preview"], ["preview", "history"], ["editor", "revisions"],
              ["revisions", "editor"], ["editor", "help"], ["help", "editor"]]
  },
  "features": ["spa", "client-state", "server-state", "undo-redo", "conditional-section", "enable-disable",
               "dynamic-validation", "reload-persistence"],
  "vocabulary": {"progress_keys": ["act.save", "act.preview_next", "act.add_question", "act.tab_preview"]},
  "regions": {
    "history_ahead": "#history-ahead",
    "history_last_kind": "#history-last-kind",
    "question_count": "#question-count",
    "unsaved_flag": "#unsaved-flag",
    "saved_summary": "#saved-summary",
    "preview_step": "#preview-step",
    "preview_answer_2": "#preview-answer-2",
    "preview_rule_2": "#preview-rule-2",
    "preview_end": "#preview-end"
  },
  "workflows": [
    {"name": "add a question and save",
     "trace": [{"type": "CLICK", "id": "add-question"},
               {"type": "CLICK", "id": "save-quiz"}],
     "expect": [{"region": "saved_summary", "contains": "7"},
                {"region": "saved_summary", "contains": "2"},
                {"region": "question_count", "contains": "7"}]},
    {"name": "make Q5 required and save",
     "trace": [{"type": "CLICK", "id": "q-5"},
               {"type": "CLICK", "id": "q-required"},
               {"type": "CLICK", "id": "save-quiz"}],
     "expect": [{"region": "saved_summary", "contains": "3"},
                {"region": "saved_summary", "contains": "6"}]},
    {"name": "preview: answer No at Q2",
     "trace": [{"type": "CLICK", "id": "tab-preview"},
               {"type": "CLICK", "id": "preview-next"},
               {"type": "SELECT", "id": "answer-2", "params": {"option": "no"}},
               {"type": "CLICK", "id": "preview-next"}],
     "expect": [{"region": "preview_step", "contains": "4"},
                {"region": "preview_rule_2", "contains": "4"}],
     "commits": false},
    {"name": "delete Q6 then undo",
     "trace": [{"type": "CLICK", "id": "q-6"},
               {"type": "CLICK", "id": "delete-question"},
               {"type": "CLICK", "id": "undo"}],
     "expect": [{"region": "question_count", "contains": "6"},
                {"region": "history_ahead", "contains": "1"}],
     "commits": false},
    {"name": "walk the whole preview answering Yes at Q2",
     "trace": [{"type": "CLICK", "id": "tab-preview"},
               {"type": "CLICK", "id": "preview-next"},
               {"type": "SELECT", "id": "answer-2", "params": {"option": "yes"}},
               {"type": "CLICK", "id": "preview-next"},
               {"type": "CLICK", "id": "preview-next"},
               {"type": "SELECT", "id": "answer-4", "params": {"option": "5"}},
               {"type": "CLICK", "id": "preview-next"},
               {"type": "CLICK", "id": "preview-next"},
               {"type": "CLICK", "id": "preview-next"}],
     "expect": [{"region": "preview_end", "contains": ""}],
     "commits": false}
  ],
  "state_dependent": [
    {"name": "Save revision creates a revision only when there are unsaved changes",
     "useless": {"trace": [],
                 "action": {"type": "CLICK", "id": "save-quiz"}},
     "useful": {"trace": [{"type": "CLICK", "id": "q-5"},
                          {"type": "CLICK", "id": "q-required"}],
                "action": {"type": "CLICK", "id": "save-quiz"}}}
  ],
  "decoys": [
    {"name": "Copy survey link", "trace": [], "decoy": {"type": "CLICK", "id": "copy-link"}},
    {"name": "Check spelling", "trace": [], "decoy": {"type": "CLICK", "id": "spell-check"}}
  ],
  "faults": [
    {
      "fault_id": "QUIZ-1",
      "fault_class": "state_corruption",
      "subtype": "stale-state",
      "defect_type": "undo/redo: redo stack survives a new edit",
      "oracle": "existing",
      "description": "Executing a new command after an undo should discard the redo branch. The clear is missing, so after undo + a new edit the history still offers a redo of the abandoned change, which would re-apply it on top of the new one.",
      "trigger_condition": "Make a change, undo it, then make a different change.",
      "expected_behaviour": "A new change after an undo ends the redo branch.",
      "observable_violation": "Right after a new change the history panel shows 1 step ahead (Redo enabled).",
      "assertions": [
        {"kind": "text_absent", "where": "/quiz", "region": "history_last_kind", "expected": "Change",
         "describes": "the latest history operation is a new change ..."},
        {"kind": "text_equals", "where": "/quiz", "region": "history_ahead", "expected": "0",
         "describes": "... so nothing is left to redo"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 4,
      "trigger_trace": [
        {"type": "CLICK", "id": "q-2"},
        {"type": "CLICK", "id": "q-required"},
        {"type": "CLICK", "id": "undo"},
        {"type": "TYPE", "id": "q-title", "params": {"category": "valid_typical"}}],
      "patch": {"file": "src/static/editor.js",
                "find": "    state.redo.length = 0; // a new change ends the redo branch\n",
                "replace": ""}
    },
    {
      "fault_id": "QUIZ-2",
      "fault_class": "broken_transition",
      "subtype": "conditional-ui",
      "defect_type": "skip logic compares the answer's display label with the stored value",
      "oracle": "existing",
      "description": "Preview's Next applies Q2's rule by comparing the stored answer value ('no') with the option's display label ('No'), so the rule never matches and a member who answered No is shown Q3, which the survey says to skip.",
      "trigger_condition": "In the preview, answer No at question 2 and go on.",
      "expected_behaviour": "A member who answers No to Q2 goes straight to the question the rule names.",
      "observable_violation": "Preview shows question 3 although Q2 was answered No and Q2's rule says skip to 4.",
      "assertions": [
        {"kind": "text_absent", "where": "view=preview", "region": "preview_step", "expected": "3",
         "describes": "question 3 is shown ..."},
        {"kind": "text_absent", "where": "view=preview", "region": "preview_answer_2", "expected": "No",
         "describes": "... while this run answered Q2 with No ..."},
        {"kind": "text_absent", "where": "view=preview", "region": "preview_rule_2", "expected": "4",
         "describes": "... and Q2's rule skips No to question 4"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 4,
      "trigger_trace": [
        {"type": "CLICK", "id": "tab-preview"},
        {"type": "CLICK", "id": "preview-next"},
        {"type": "SELECT", "id": "answer-2", "params": {"option": "no"}},
        {"type": "CLICK", "id": "preview-next"}],
      "patch": {"file": "src/static/preview.js",
                "find": "if (answers[q.id] === rule.when) return rule.target;",
                "replace": "if (answers[q.id] === labelOf(q, rule.when)) return rule.target;"}
    },
    {
      "fault_id": "QUIZ-3",
      "fault_class": "persistence_failure",
      "subtype": "persistence",
      "defect_type": "save serialises a stale snapshot (the frozen preview copy)",
      "oracle": "extension",
      "description": "Entering preview freezes a copy of the document for the respondent walk-through. Save serialises that frozen copy when one exists instead of the working copy, so edits made after a preview are acknowledged ('Saved') but not stored, and a reload brings back the older document.",
      "trigger_condition": "Open the preview, return to the editor, change the survey, save, reload.",
      "expected_behaviour": "Every saved revision contains the edits made before Save.",
      "observable_violation": "After saving, the summary says 'Revision 2: 7 questions'; after a reload it says 'Revision 2: 6 questions'.",
      "assertions": [{"kind": "region_stable_across_reload", "where": "/quiz", "region": "saved_summary",
                      "describes": "what the page says was saved is what the server returns after a reload"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 1,
      "shortest_path": 5,
      "trigger_trace": [
        {"type": "CLICK", "id": "tab-preview"},
        {"type": "CLICK", "id": "tab-editor"},
        {"type": "CLICK", "id": "add-question"},
        {"type": "CLICK", "id": "save-quiz"},
        {"type": "REFRESH"}],
      "patch": {"file": "src/static/editor.js",
                "find": "const payload = serialize(state.doc);",
                "replace": "const payload = serialize(state.previewDoc || state.doc);"}
    }
  ],
  "benign_traces": [
    [{"type": "CLICK", "id": "q-5"},
     {"type": "CLICK", "id": "q-required"},
     {"type": "CLICK", "id": "save-quiz"},
     {"type": "CLICK", "id": "nav-revisions"}],
    [{"type": "CLICK", "id": "tab-preview"},
     {"type": "CLICK", "id": "preview-next"},
     {"type": "SELECT", "id": "answer-2", "params": {"option": "yes"}},
     {"type": "CLICK", "id": "preview-next"},
     {"type": "CLICK", "id": "tab-editor"}]
  ]
}
