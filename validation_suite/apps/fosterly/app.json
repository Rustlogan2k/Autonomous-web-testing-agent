{
  "app_id": "fosterly",
  "name": "Fosterly",
  "domain": "animal rescue: an application to become a foster carer for rescue dogs and cats",
  "user_goal": "Fill in a foster-carer application section by section with every answer saved as you go, leave and continue it later by its reference, review it and submit it.",
  "architecture": "single-page-accordion-form+field-autosave-api",
  "stack": "node-builtins+json-files",
  "persistence": "one JSON file per session: drafts stored field by field as each change is accepted, and submitted applications (immutable); the client keeps an optimistic copy of accepted answers for the section summaries",
  "entry": "/",
  "start": ["node", "src/server.js"],
  "dockerfile": true,
  "workflow_graph": {
    "kind": ["accordion", "nested-form", "revisit", "save-and-resume"],
    "nodes": ["start", "apply", "apply:section-open", "apply:other-animals", "review", "application",
              "applications", "submitted-draft", "help"],
    "edges": [["start", "apply"], ["start", "apply:section-open"], ["apply", "apply:section-open"],
              ["apply:section-open", "apply:section-open"], ["apply:section-open", "apply:other-animals"],
              ["apply:other-animals", "apply:section-open"], ["apply:section-open", "review"],
              ["apply", "review"], ["review", "apply"], ["review", "review"], ["review", "application"],
              ["application", "applications"], ["applications", "application"], ["applications", "start"],
              ["start", "applications"], ["start", "help"], ["help", "start"], ["review", "submitted-draft"],
              ["submitted-draft", "application"]]
  },
  "features": ["accordion", "autosave", "progressive-disclosure", "conditional-section", "client-state",
               "server-state", "reload-persistence", "dynamic-validation", "cross-page-state"],
  "vocabulary": {"progress_keys": ["act.start_new", "act.resume", "act.to_review", "act.submit", "act.back_to_form"]},
  "regions": {
    "completeness": "#completeness",
    "summary_about": "#summary-about",
    "summary_home": "#summary-home",
    "summary_availability": "#summary-availability",
    "review_status": "#review-status",
    "flash": "#flash",
    "sub_ref": "#sub-ref",
    "sub_other_animals": "#sub-other-animals",
    "sub_animals": "#sub-animals",
    "sub_available": "#sub-available"
  },
  "workflows": [
    {"name": "continue FOS-1001 and submit",
     "trace": [{"type": "CLICK", "id": "resume-FOS-1001"},
               {"type": "CLICK", "id": "to-review"},
               {"type": "CLICK", "id": "submit-application"}],
     "expect": [{"region": "sub_ref", "contains": "FA-2001"},
                {"region": "sub_available", "contains": "1 Jul 2026"},
                {"region": "sub_animals", "absent": "x"}]},
    {"name": "new application, fill About you",
     "trace": [{"type": "CLICK", "id": "start-new"},
               {"type": "CLICK", "id": "acc-about"},
               {"type": "TYPE", "id": "full-name", "params": {"category": "valid_typical"}},
               {"type": "TYPE", "id": "email", "params": {"category": "valid_typical"}},
               {"type": "TYPE", "id": "phone", "params": {"category": "valid_typical"}}],
     "expect": [{"region": "completeness", "contains": "1"},
                {"region": "summary_about", "contains": "tester@example.com"}]},
    {"name": "tick other animals, choose 2 cats, submit FOS-1001",
     "trace": [{"type": "CLICK", "id": "resume-FOS-1001"},
               {"type": "CLICK", "id": "acc-home"},
               {"type": "CLICK", "id": "other-animals"},
               {"type": "SELECT", "id": "animal-species", "params": {"option": "cat"}},
               {"type": "SELECT", "id": "animal-count", "params": {"option": "2"}},
               {"type": "CLICK", "id": "to-review"},
               {"type": "CLICK", "id": "submit-application"}],
     "expect": [{"region": "sub_ref", "contains": "FA-2001"},
                {"region": "sub_animals", "contains": "2"},
                {"region": "sub_animals", "contains": "Cat"}]},
    {"name": "set availability on a new draft",
     "trace": [{"type": "CLICK", "id": "start-new"},
               {"type": "CLICK", "id": "acc-availability"},
               {"type": "TYPE", "id": "available-from", "params": {"category": "valid_typical"}}],
     "expect": [{"region": "summary_availability", "contains": "15 Jun 2026"},
                {"region": "completeness", "contains": "0"}]},
    {"name": "an incomplete application is not submitted",
     "trace": [{"type": "CLICK", "id": "start-new"},
               {"type": "CLICK", "id": "to-review"},
               {"type": "CLICK", "id": "submit-application"}],
     "expect": [{"region": "review_status", "contains": "0"},
                {"region": "flash", "contains": ""}]}
  ],
  "state_dependent": [
    {"name": "Submit application is refused while a section is incomplete and submits once all are complete",
     "useless": {"trace": [{"type": "CLICK", "id": "start-new"},
                           {"type": "CLICK", "id": "to-review"}],
                 "action": {"type": "CLICK", "id": "submit-application"}},
     "useful": {"trace": [{"type": "CLICK", "id": "resume-FOS-1001"},
                          {"type": "CLICK", "id": "to-review"}],
                "action": {"type": "CLICK", "id": "submit-application"}}},
    {"name": "Ticking the declaration is refused until About you is complete",
     "useless": {"trace": [{"type": "CLICK", "id": "start-new"},
                           {"type": "CLICK", "id": "acc-declaration"}],
                 "action": {"type": "CLICK", "id": "declaration"}},
     "useful": {"trace": [{"type": "CLICK", "id": "start-new"},
                          {"type": "CLICK", "id": "acc-about"},
                          {"type": "TYPE", "id": "full-name", "params": {"category": "valid_typical"}},
                          {"type": "TYPE", "id": "email", "params": {"category": "valid_typical"}},
                          {"type": "TYPE", "id": "phone", "params": {"category": "valid_typical"}},
                          {"type": "CLICK", "id": "acc-declaration"}],
                "action": {"type": "CLICK", "id": "declaration"}}}
  ],
  "decoys": [
    {"name": "Print a copy on the review page",
     "trace": [{"type": "CLICK", "id": "resume-FOS-1001"},
               {"type": "CLICK", "id": "to-review"}],
     "decoy": {"type": "CLICK", "id": "print-copy"}},
    {"name": "What fostering involves (information page)",
     "trace": [],
     "decoy": {"type": "CLICK", "id": "nav-help"}}
  ],
  "faults": [
    {
      "fault_id": "FOST-1",
      "fault_class": "persistence_failure",
      "subtype": "persistence",
      "defect_type": "autosave field silently dropped by the server's field allow-list",
      "oracle": "extension",
      "description": "The availability section's allow-list names the field 'availableFrom' while the form sends 'available_from'. The server filters the PATCH body by the allow-list, stores nothing, and still answers ok, so the summary updates but the answer is gone after a reload.",
      "trigger_condition": "On a new draft, give an availability date, then reload the page.",
      "expected_behaviour": "Every answer the page accepts is kept.",
      "observable_violation": "The Availability summary reads 'From 15 Jun 2026' before the reload and 'Not started' after it.",
      "assertions": [{"kind": "region_stable_across_reload", "where": "/apply/FOS-\\d+$", "region": "summary_availability",
                      "describes": "an answer the page accepted is still there after a reload"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 1,
      "shortest_path": 4,
      "trigger_trace": [
        {"type": "CLICK", "id": "start-new"},
        {"type": "CLICK", "id": "acc-availability"},
        {"type": "TYPE", "id": "available-from", "params": {"category": "valid_typical"}},
        {"type": "REFRESH"}],
      "patch": {"file": "src/fields.js",
                "find": "availability: [\"available_from\", \"min_weeks\"],",
                "replace": "availability: [\"availableFrom\", \"min_weeks\"],"}
    },
    {
      "fault_id": "FOST-2",
      "fault_class": "state_corruption",
      "subtype": "conditional-ui",
      "defect_type": "answers in a hidden (unticked) sub-section are submitted",
      "oracle": "extension",
      "description": "When 'Other animals at home' is unticked the animals sub-section is hidden, but its earlier answers stay in the draft. Submission copies draft.animals without checking the tick, so the application says 'Other animals: No' and still lists the hidden animals.",
      "trigger_condition": "Tick 'Other animals at home', describe an animal, untick the box again, then submit.",
      "expected_behaviour": "What is submitted is what the applicant can see.",
      "observable_violation": "The submitted application shows 'Other animals: No' and lists '2 x Cat'.",
      "assertions": [
        {"kind": "text_absent", "where": "/applications/FA-\\d+$", "region": "sub_other_animals", "expected": "No",
         "describes": "the applicant said they have no other animals ..."},
        {"kind": "input_absent", "where": "/applications/FA-\\d+$", "region": "sub_animals", "input_field": "animal_species",
         "describes": "... so no animal they described in the hidden section is on the application"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 7,
      "trigger_trace": [
        {"type": "CLICK", "id": "resume-FOS-1001"},
        {"type": "CLICK", "id": "acc-home"},
        {"type": "CLICK", "id": "other-animals"},
        {"type": "SELECT", "id": "animal-species", "params": {"option": "cat"}},
        {"type": "SELECT", "id": "animal-count", "params": {"option": "2"}},
        {"type": "CLICK", "id": "other-animals"},
        {"type": "CLICK", "id": "to-review"},
        {"type": "CLICK", "id": "submit-application"}],
      "patch": {"file": "src/applications.js",
                "find": "animals: draft.other_animals ? draft.animals : [],",
                "replace": "animals: draft.animals,"}
    },
    {
      "fault_id": "FOST-3",
      "fault_class": "constraint_bypass",
      "subtype": "missing-validation",
      "defect_type": "conditional requirement ignored by the completeness check",
      "oracle": "existing",
      "description": "Home completeness should require species and count when 'Other animals at home' is ticked. The condition reads draft.otherAnimals (never set), so the section counts as complete with the box ticked and nothing described, and the application can be submitted.",
      "trigger_condition": "Tick 'Other animals at home' on a complete draft, describe no animal and submit.",
      "expected_behaviour": "An application that says the applicant has other animals says which.",
      "observable_violation": "The submitted application shows 'Other animals: Yes' with no animals listed.",
      "assertions": [
        {"kind": "text_absent", "where": "/applications/FA-\\d+$", "region": "sub_other_animals", "expected": "Yes",
         "describes": "the applicant said they have other animals ..."},
        {"kind": "region_empty", "where": "/applications/FA-\\d+$", "region": "sub_animals",
         "describes": "... so the application describes at least one"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 5,
      "trigger_trace": [
        {"type": "CLICK", "id": "resume-FOS-1001"},
        {"type": "CLICK", "id": "acc-home"},
        {"type": "CLICK", "id": "other-animals"},
        {"type": "CLICK", "id": "to-review"},
        {"type": "CLICK", "id": "submit-application"}],
      "patch": {"file": "src/fields.js",
                "find": "if (draft.other_animals) required.push(\"animal_species\", \"animal_count\");",
                "replace": "if (draft.otherAnimals) required.push(\"animal_species\", \"animal_count\");"}
    }
  ],
  "benign_traces": [
    [{"type": "CLICK", "id": "resume-FOS-1001"},
     {"type": "CLICK", "id": "to-review"},
     {"type": "CLICK", "id": "submit-application"}],
    [{"type": "CLICK", "id": "start-new"},
     {"type": "CLICK", "id": "acc-about"},
     {"type": "TYPE", "id": "full-name", "params": {"category": "valid_typical"}},
     {"type": "TYPE", "id": "email", "params": {"category": "valid_typical"}},
     {"type": "CLICK", "id": "acc-home"},
     {"type": "SELECT", "id": "home-type", "params": {"option": "house"}}]
  ]
}
