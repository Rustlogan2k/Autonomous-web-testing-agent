{
  "app_id": "markbook",
  "name": "Markbook",
  "domain": "school assessment: a teacher's markbook for one class, with each student's view of published marks",
  "user_goal": "Enter and correct marks, see each student's weighted percentage and level, set assessment maxima, publish assessments, keep private notes, and check what a student sees.",
  "architecture": "server-rendered-matrix+click-to-edit-cells+role-route-trees",
  "stack": "python-stdlib-wsgiref+sqlite",
  "persistence": "one sqlite file per session copied from a seeded template; marks, assessments (max, weight, published), notes with a visibility column",
  "entry": "/teacher",
  "start": ["python", "src/server.py"],
  "dockerfile": true,
  "workflow_graph": {
    "kind": ["data-grid", "hub-and-spoke", "multi-role-views", "revisit"],
    "nodes": ["classes-hub", "markbook", "cell-editor", "export-help", "assessment", "student-record",
              "student-view", "levels-report", "help"],
    "edges": [["classes-hub", "markbook"], ["markbook", "cell-editor"], ["cell-editor", "markbook"],
              ["markbook", "export-help"], ["markbook", "assessment"], ["assessment", "assessment"],
              ["assessment", "markbook"], ["markbook", "student-record"], ["student-record", "student-record"],
              ["student-record", "student-view"], ["student-view", "student-record"],
              ["student-record", "markbook"], ["markbook", "levels-report"], ["levels-report", "markbook"],
              ["classes-hub", "help"], ["help", "classes-hub"]]
  },
  "features": ["server-rendered", "inline-edit", "table", "multi-role", "server-state", "enable-disable",
               "dynamic-validation", "cross-page-state", "derived-columns"],
  "nearest_existing": {"app": "stackroom", "also_close": ["ledgerly"]},
  "vocabulary": {"progress_keys": ["act.save_mark", "act.save_assessment", "act.publish", "act.save_feedback",
                                   "act.save_note"]},
  "regions": {
    "pct_s1": "#pct-s1",
    "pct_s3": "#pct-s3",
    "level_s3": "#level-s3",
    "mark_s3_hw": "#mark-s3-hw",
    "mark_s3_quiz": "#mark-s3-quiz",
    "mark_s3_proj": "#mark-s3-proj",
    "mark_s3_exam": "#mark-s3-exam",
    "max_hw": "#max-hw",
    "max_quiz": "#max-quiz",
    "max_proj": "#max-proj",
    "max_exam": "#max-exam",
    "cell_error": "#cell-error",
    "assess_flash": "#assess-flash",
    "student_view": "#student-view",
    "student_comments": "#student-comments"
  },
  "workflows": [
    {"name": "give Chen 42 in the exam",
     "trace": [{"type": "CLICK", "id": "class-10b"}, {"type": "CLICK", "id": "mark-s3-exam"},
               {"type": "TYPE", "id": "mark", "params": {"category": "valid_typical"}},
               {"type": "CLICK", "id": "save-mark"}],
     "expect": [{"region": "pct_s3", "contains": "67.1"}, {"region": "mark_s3_exam", "contains": "42"}]},
    {"name": "publish the exam, then Amara's own page shows her exam mark",
     "trace": [{"type": "CLICK", "id": "class-10b"}, {"type": "CLICK", "id": "assess-exam"},
               {"type": "CLICK", "id": "publish-assessment"}, {"type": "CLICK", "id": "back-to-markbook"},
               {"type": "CLICK", "id": "student-s1"}, {"type": "CLICK", "id": "preview-as-student"}],
     "expect": [{"region": "student_view", "contains": "85 / 120"},
                {"region": "student_view", "contains": "83.6%"}]},
    {"name": "raise the quiz maximum to 42",
     "trace": [{"type": "CLICK", "id": "class-10b"}, {"type": "CLICK", "id": "assess-quiz"},
               {"type": "TYPE", "id": "max-marks", "params": {"category": "valid_typical"}},
               {"type": "CLICK", "id": "save-assessment"}, {"type": "CLICK", "id": "back-to-markbook"}],
     "expect": [{"region": "max_quiz", "contains": "42"}, {"region": "pct_s1", "contains": "78.6"}]},
    {"name": "give Bilal feedback from the comment bank",
     "trace": [{"type": "CLICK", "id": "class-10b"}, {"type": "CLICK", "id": "student-s2"},
               {"type": "SELECT", "id": "feedback", "params": {"option": "cb2"}},
               {"type": "CLICK", "id": "save-feedback"}, {"type": "CLICK", "id": "preview-as-student"}],
     "expect": [{"region": "student_comments", "contains": "keep practising algebra"}]}
  ],
  "state_dependent": [
    {"name": "Save maximum is refused below a mark already given (the exam: 102) and saves a maximum above every mark (the quiz)",
     "useless": {"trace": [{"type": "CLICK", "id": "class-10b"}, {"type": "CLICK", "id": "assess-exam"},
                           {"type": "TYPE", "id": "max-marks", "params": {"category": "valid_typical"}}],
                 "action": {"type": "CLICK", "id": "save-assessment"}},
     "useful": {"trace": [{"type": "CLICK", "id": "class-10b"}, {"type": "CLICK", "id": "assess-quiz"},
                          {"type": "TYPE", "id": "max-marks", "params": {"category": "valid_typical"}}],
                "action": {"type": "CLICK", "id": "save-assessment"}}},
    {"name": "Publish publishes a draft assessment and is refused on one already published",
     "useless": {"trace": [{"type": "CLICK", "id": "class-10b"}, {"type": "CLICK", "id": "assess-quiz"}],
                 "action": {"type": "CLICK", "id": "publish-assessment"}},
     "useful": {"trace": [{"type": "CLICK", "id": "class-10b"}, {"type": "CLICK", "id": "assess-exam"}],
                "action": {"type": "CLICK", "id": "publish-assessment"}}}
  ],
  "decoys": [
    {"name": "Exporting marks (help panel on the markbook)", "trace": [{"type": "CLICK", "id": "class-10b"}],
     "decoy": {"type": "CLICK", "id": "export-csv-help"}},
    {"name": "Levels report (read-only)", "trace": [{"type": "CLICK", "id": "class-10b"}],
     "decoy": {"type": "CLICK", "id": "nav-report"}}
  ],
  "faults": [
    {
      "fault_id": "MARK-1",
      "fault_class": "calculation_error",
      "subtype": "calculation",
      "defect_type": "rounding: truncation instead of half-up",
      "oracle": "extension",
      "description": "The weighted percentage is quantised with ROUND_DOWN instead of ROUND_HALF_UP, so 67.0833...% is shown as 67.0 instead of 67.1 (and any value whose hundredths digit is 5 or more is shown a tenth too low).",
      "trigger_condition": "Complete a student's marks so that the weighted percentage has a hundredths digit of 5 or more: give Chen 42 in the exam.",
      "expected_behaviour": "Percentages are rounded to the nearest tenth, halves up.",
      "observable_violation": "Chen's weighted percentage shows 67.0% for marks 17/20, 20/30, 35/40, 42/120 (exactly 67.083%).",
      "assertions": [{"kind": "region_arithmetic", "where": "/teacher/classes/10b$",
                      "expression": "pct == hw * 20 / mhw + quiz * 20 / mquiz + proj * 30 / mproj + exam * 30 / mexam",
                      "tolerance": 0.0501,
                      "operands": {"pct": "pct_s3", "hw": "mark_s3_hw", "quiz": "mark_s3_quiz",
                                   "proj": "mark_s3_proj", "exam": "mark_s3_exam", "mhw": "max_hw",
                                   "mquiz": "max_quiz", "mproj": "max_proj", "mexam": "max_exam"},
                      "describes": "the weighted percentage is the weighted sum of the marks, correctly rounded to one decimal"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 4,
      "trigger_trace": [
        {"type": "CLICK", "id": "class-10b"}, {"type": "CLICK", "id": "mark-s3-exam"},
        {"type": "TYPE", "id": "mark", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "save-mark"}],
      "patch": {"file": "src/grades.py",
                "find": ".quantize(TENTH, rounding=decimal.ROUND_HALF_UP)",
                "replace": ".quantize(TENTH, rounding=decimal.ROUND_DOWN)"}
    },
    {
      "fault_id": "MARK-2",
      "fault_class": "constraint_bypass",
      "subtype": "missing-validation",
      "defect_type": "invariant-breaking configuration change (check scoped to published marks only)",
      "oracle": "extension",
      "description": "Lowering an assessment's maximum below a mark already given must be refused. The check reuses the student view's flavour of the highest-mark query, which only sees published marks, so for the unpublished exam no mark is found and any lower maximum is accepted; students then score more than 100%.",
      "trigger_condition": "Open the (draft) exam, set its maximum to 42 although students have up to 102, save, and go back to the markbook.",
      "expected_behaviour": "No student can score more than 100% of an assessment.",
      "observable_violation": "After setting the exam maximum to 42, Amara's weighted percentage is 123.0% (18 + 17.33 + 27 + 85 x 30/42).",
      "assertions": [{"kind": "region_arithmetic", "where": "/teacher/classes/10b$", "expression": "pct <= 100",
                      "operands": {"pct": "pct_s1"},
                      "describes": "no student's weighted percentage exceeds 100"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 1,
      "shortest_path": 5,
      "trigger_trace": [
        {"type": "CLICK", "id": "class-10b"}, {"type": "CLICK", "id": "assess-exam"},
        {"type": "TYPE", "id": "max-marks", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "save-assessment"}, {"type": "CLICK", "id": "back-to-markbook"}],
      "patch": {"file": "src/server.py",
                "find": "highest = highest_mark(conn, assessment_id, published_only=False)",
                "replace": "highest = highest_mark(conn, assessment_id, published_only=True)"}
    },
    {
      "fault_id": "MARK-3",
      "fault_class": "state_corruption",
      "subtype": "cross-page",
      "defect_type": "role-dependent visibility: a private note becomes visible to the student after it is edited",
      "oracle": "existing",
      "description": "A teacher's private note is created with visibility 'teacher'. Editing it rewrites the row without the visibility column, so the column default ('shared', the value canned feedback uses) applies and the student's own page lists the private note.",
      "trigger_condition": "Write a private note on a student's record, save it, edit it and save again, then preview the student's page.",
      "expected_behaviour": "Private notes are only ever shown to the teacher.",
      "observable_violation": "Bilal's student view lists an entry badged 'Private note' with the teacher's text.",
      "assertions": [{"kind": "text_absent", "where": "/student/s\\d+$", "region": "student_comments",
                      "expected": "Private", "describes": "a student never sees a teacher's private note"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 1,
      "shortest_path": 7,
      "trigger_trace": [
        {"type": "CLICK", "id": "class-10b"}, {"type": "CLICK", "id": "student-s2"},
        {"type": "TYPE", "id": "private-note", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "save-note"}, {"type": "CLICK", "id": "edit-note"},
        {"type": "TYPE", "id": "private-note", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "save-note"}, {"type": "CLICK", "id": "preview-as-student"}],
      "patch": {"file": "src/notes.py",
                "find": "INSERT OR REPLACE INTO notes (id, student, body, visibility) VALUES (?, ?, ?, 'teacher')",
                "replace": "INSERT OR REPLACE INTO notes (id, student, body) VALUES (?, ?, ?)"}
    }
  ],
  "benign_traces": [
    [{"type": "CLICK", "id": "class-10b"}, {"type": "CLICK", "id": "mark-s2-quiz"},
     {"type": "TYPE", "id": "mark", "params": {"category": "boundary_min"}},
     {"type": "CLICK", "id": "save-mark"}, {"type": "CLICK", "id": "student-s2"},
     {"type": "CLICK", "id": "preview-as-student"}],
    [{"type": "CLICK", "id": "class-10b"}, {"type": "CLICK", "id": "assess-quiz"},
     {"type": "TYPE", "id": "max-marks", "params": {"category": "valid_typical"}},
     {"type": "CLICK", "id": "save-assessment"}, {"type": "CLICK", "id": "back-to-markbook"}]
  ]
}
