{
  "app_id": "skylark",
  "name": "Skylark",
  "domain": "citizen science: a local nature group's bird-sightings register",
  "user_goal": "Read the group's sightings newest first, load older ones, filter by site, record a sighting, flag doubtful records, and see how many birds the listed sightings add up to.",
  "architecture": "server-rendered-first-page+load-more-append(keyset cursor)+client-draft",
  "stack": "node-builtins+json-files",
  "persistence": "one JSON file per session (sightings with a verification status); unsent record-form drafts in the browser's localStorage",
  "entry": "/feed",
  "start": ["node", "src/server.js"],
  "dockerfile": true,
  "workflow_graph": {
    "kind": ["feed", "hub-and-spoke", "linear-wizard", "revisit"],
    "nodes": ["feed", "feed:appended-page", "record:where", "record:what", "sighting", "sighting:share-panel",
              "sighting:map-panel", "sites", "site", "summary", "help"],
    "edges": [["feed", "feed:appended-page"], ["feed:appended-page", "feed:appended-page"], ["feed", "feed"],
              ["feed", "sighting"], ["feed:appended-page", "sighting"], ["sighting", "sighting"],
              ["sighting", "sighting:share-panel"], ["sighting", "sighting:map-panel"], ["sighting", "feed"],
              ["sighting", "site"], ["feed", "record:where"], ["record:where", "record:what"],
              ["record:what", "record:where"], ["record:what", "record:what"], ["record:what", "feed"],
              ["feed", "sites"], ["sites", "site"], ["site", "feed"], ["site", "sites"], ["feed", "summary"],
              ["summary", "feed"], ["feed", "help"], ["help", "feed"]]
  },
  "features": ["server-rendered", "load-more-pagination", "filter", "client-state", "server-state",
               "reload-persistence", "table", "cross-page-state", "aggregation"],
  "vocabulary": {"progress_keys": ["act.new_sighting", "act.choose_site", "act.save_sighting", "act.load_more",
                                   "act.apply_filter", "act.flag_doubtful", "act.restore"]},
  "regions": {
    "shown_count": "#shown-count",
    "total_count": "#total-count",
    "feed_end": "#feed-end",
    "feed_list": "#feed-list",
    "tally_total": "#tally-total",
    "tally_marsh": "#tally-marsh",
    "tally_wood": "#tally-wood",
    "tally_lake": "#tally-lake",
    "draft_summary": "#draft-summary",
    "sighting_status": "#sighting-status",
    "flash": "#flash"
  },
  "workflows": [
    {"name": "load every page of the feed",
     "trace": [{"type": "CLICK", "id": "load-more"},
               {"type": "CLICK", "id": "load-more"},
               {"type": "CLICK", "id": "load-more"}],
     "expect": [{"region": "feed_end", "contains": ""},
                {"region": "shown_count", "contains": "22"},
                {"region": "total_count", "contains": "22"},
                {"region": "feed_list", "contains": "2026-05-20"}],
     "commits": false},
    {"name": "record a heron at the marsh hide",
     "trace": [{"type": "CLICK", "id": "new-sighting"},
               {"type": "CLICK", "id": "choose-site"},
               {"type": "SELECT", "id": "species", "params": {"option": "heron"}},
               {"type": "CLICK", "id": "save-sighting"}],
     "expect": [{"region": "flash", "contains": "s23"},
                {"region": "feed_list", "contains": "Heron"},
                {"region": "total_count", "contains": "23"}]},
    {"name": "filter the feed to the marsh hide",
     "trace": [{"type": "SELECT", "id": "filter-site", "params": {"option": "marsh"}},
               {"type": "CLICK", "id": "apply-filter"}],
     "expect": [{"region": "feed_list", "contains": "Marsh hide"},
                {"region": "feed_list", "absent": "Wood edge"},
                {"region": "feed_list", "absent": "Lakeside"},
                {"region": "total_count", "contains": "8"}],
     "commits": false},
    {"name": "flag s20 as doubtful",
     "trace": [{"type": "CLICK", "id": "sighting-s20"},
               {"type": "CLICK", "id": "flag-doubtful"}],
     "expect": [{"region": "sighting_status", "contains": "Doubtful"},
                {"region": "flash", "contains": "s20"}]},
    {"name": "a doubtful sighting stays listed but leaves the tallies",
     "trace": [{"type": "CLICK", "id": "sighting-s20"},
               {"type": "CLICK", "id": "flag-doubtful"},
               {"type": "CLICK", "id": "back-to-feed"}],
     "expect": [{"region": "feed_list", "contains": "Wren"},
                {"region": "tally_wood", "contains": "6"},
                {"region": "tally_total", "contains": "15"}]},
    {"name": "an unsent sighting survives a reload of the record form",
     "trace": [{"type": "CLICK", "id": "new-sighting"},
               {"type": "SELECT", "id": "where-site", "params": {"option": "lake"}},
               {"type": "CLICK", "id": "choose-site"},
               {"type": "SELECT", "id": "species", "params": {"option": "wren"}},
               {"type": "TYPE", "id": "count", "params": {"category": "valid_typical"}},
               {"type": "REFRESH"}],
     "expect": [{"region": "draft_summary", "contains": "Wren"},
                {"region": "draft_summary", "contains": "42"},
                {"region": "draft_summary", "contains": "Lakeside"}],
     "commits": false}
  ],
  "state_dependent": [
    {"name": "Save sighting is refused without a species and records the sighting once one is chosen",
     "useless": {"trace": [{"type": "CLICK", "id": "new-sighting"},
                           {"type": "CLICK", "id": "choose-site"}],
                 "action": {"type": "CLICK", "id": "save-sighting"}},
     "useful": {"trace": [{"type": "CLICK", "id": "new-sighting"},
                          {"type": "CLICK", "id": "choose-site"},
                          {"type": "SELECT", "id": "species", "params": {"option": "heron"}}],
                "action": {"type": "CLICK", "id": "save-sighting"}}},
    {"name": "Flag as doubtful changes a verified sighting and is refused on one already flagged",
     "useless": {"trace": [{"type": "CLICK", "id": "sighting-s20"},
                           {"type": "CLICK", "id": "flag-doubtful"}],
                 "action": {"type": "CLICK", "id": "flag-doubtful"}},
     "useful": {"trace": [{"type": "CLICK", "id": "sighting-s20"}],
                "action": {"type": "CLICK", "id": "flag-doubtful"}}}
  ],
  "decoys": [
    {"name": "Share on a sighting's page", "trace": [{"type": "CLICK", "id": "sighting-s20"}],
     "decoy": {"type": "CLICK", "id": "share-sighting"}},
    {"name": "Show on map on a sighting's page", "trace": [{"type": "CLICK", "id": "sighting-s21"}],
     "decoy": {"type": "CLICK", "id": "show-map"}}
  ],
  "faults": [
    {
      "fault_id": "SKY-1",
      "fault_class": "state_corruption",
      "subtype": "incorrect-navigation",
      "defect_type": "keyset pagination boundary: a date-only cursor skips same-date rows",
      "oracle": "extension",
      "description": "The next page of the feed is selected with date < cursor.date only, dropping the (date, id) tie-break. Whenever a page ends inside a run of same-date sightings the rest of that run is skipped. The seed has no such boundary; recording one new sighting moves a same-date pair onto the first page boundary, and the second row of the pair is never listed.",
      "trigger_condition": "Record any sighting dated today, then load every page of the unfiltered feed.",
      "expected_behaviour": "Loading every page lists every sighting exactly once.",
      "observable_violation": "At the end of the feed (pages 1-6, 8-13, 14-19, 20-23): 'Showing 22 of 23 sightings'.",
      "assertions": [{"kind": "region_arithmetic", "where": "/feed(\\?.*)?$", "expression": "shown == total",
                      "operands": {"shown": "shown_count", "total": "total_count"},
                      "guard": {"region": "feed_end", "contains": "End"},
                      "describes": "once the feed says it has ended, it lists every matching sighting"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 7,
      "trigger_trace": [
        {"type": "CLICK", "id": "new-sighting"},
        {"type": "CLICK", "id": "choose-site"},
        {"type": "SELECT", "id": "species", "params": {"option": "heron"}},
        {"type": "CLICK", "id": "save-sighting"},
        {"type": "CLICK", "id": "load-more"},
        {"type": "CLICK", "id": "load-more"},
        {"type": "CLICK", "id": "load-more"}],
      "patch": {"file": "src/sightings.js",
                "find": "rows.filter((r) => r.date < c.date || (r.date === c.date && r.id < c.id))",
                "replace": "rows.filter((r) => r.date < c.date)"}
    },
    {
      "fault_id": "SKY-2",
      "fault_class": "persistence_failure",
      "subtype": "persistence",
      "defect_type": "unsent draft listener misses dropdowns",
      "oracle": "extension",
      "description": "The record form's draft is written to localStorage by listeners bound to input and textarea elements only, so a change made with a dropdown is never saved: after choosing the species (with nothing typed afterwards) a reload restores the draft without it.",
      "trigger_condition": "On the record form, choose a species and type nothing after it, then reload the page.",
      "expected_behaviour": "Unsent input survives a reload.",
      "observable_violation": "Before the reload the draft summary says 'Heron × 1 at Marsh hide, today'; after it, 'No species yet × 1 at Marsh hide, today'.",
      "assertions": [{"kind": "region_stable_across_reload", "where": "/sightings/new/[a-z]+$", "region": "draft_summary",
                      "describes": "an unsent sighting survives a reload as it was"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 1,
      "shortest_path": 4,
      "trigger_trace": [
        {"type": "CLICK", "id": "new-sighting"},
        {"type": "CLICK", "id": "choose-site"},
        {"type": "SELECT", "id": "species", "params": {"option": "heron"}},
        {"type": "REFRESH"}],
      "patch": {"file": "src/static/record.js",
                "find": "form.querySelectorAll(\"input, select, textarea\").forEach((el) => el.addEventListener(\"input\", saveDraft));",
                "replace": "form.querySelectorAll(\"input, textarea\").forEach((el) => el.addEventListener(\"input\", saveDraft));"}
    },
    {
      "fault_id": "SKY-3",
      "fault_class": "calculation_error",
      "subtype": "calculation",
      "defect_type": "aggregation over appended pages diverges from the per-site tallies",
      "oracle": "extension",
      "description": "Tallies exclude doubtful sightings. The server-rendered first page gets this right; when a page is appended, the client adds the page's all-records sum (page.birds) to the total but the verified-only sums to each site, so a doubtful record on a later page makes the total disagree with the sites.",
      "trigger_condition": "Flag a sighting that is not on the feed's first page as doubtful, return to the feed and load the page that holds it.",
      "expected_behaviour": "The total is always the sum of the per-site figures.",
      "observable_violation": "After the append, 'Birds in the listed sightings' is 31 while Marsh hide 12 + Wood edge 8 + Lakeside 8 = 28: the flagged sighting's 3 birds are in the total only.",
      "assertions": [{"kind": "region_arithmetic", "where": "/feed(\\?.*)?$", "expression": "total == marsh + wood + lake",
                      "operands": {"total": "tally_total", "marsh": "tally_marsh", "wood": "tally_wood", "lake": "tally_lake"},
                      "describes": "the bird total is the sum of the per-site totals"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 5,
      "trigger_trace": [
        {"type": "CLICK", "id": "load-more"},
        {"type": "CLICK", "id": "sighting-s14"},
        {"type": "CLICK", "id": "flag-doubtful"},
        {"type": "CLICK", "id": "back-to-feed"},
        {"type": "CLICK", "id": "load-more"}],
      "patch": {"file": "src/static/feed.js",
                "find": "tally.total += page.countedBirds;",
                "replace": "tally.total += page.birds;"}
    }
  ],
  "benign_traces": [
    [{"type": "CLICK", "id": "load-more"},
     {"type": "CLICK", "id": "load-more"},
     {"type": "CLICK", "id": "load-more"}],
    [{"type": "SELECT", "id": "filter-site", "params": {"option": "lake"}},
     {"type": "CLICK", "id": "apply-filter"},
     {"type": "CLICK", "id": "sighting-s21"},
     {"type": "CLICK", "id": "back-to-feed"},
     {"type": "CLICK", "id": "load-more"}]
  ]
}
