{
  "app_id": "sideline",
  "name": "Sideline",
  "domain": "amateur sport: a Sunday football league's results and league table",
  "user_goal": "The league secretary records results, each club's captain confirms or disputes them, and the public sees fixtures, results and a table built from confirmed results only.",
  "architecture": "multi-role-portals(path-prefixed front doors)+server-rendered+client-sortable-table",
  "stack": "python-stdlib(http.server)+sqlite",
  "persistence": "sqlite rows partitioned by session; each result has a status (provisional / confirmed / disputed) and one confirmation flag per club; standings are derived on every request",
  "entry": "/",
  "start": ["python", "src/server.py"],
  "dockerfile": true,
  "workflow_graph": {
    "kind": ["multi-role-portal", "state-machine", "hub-and-spoke"],
    "nodes": ["landing", "sec/fixtures", "sec/result", "sec/result-edit", "club/results", "club/dispute",
              "public/table", "public/results", "public/team"],
    "edges": [["landing", "sec/fixtures"], ["landing", "club/results"], ["landing", "public/table"],
              ["sec/fixtures", "sec/result"], ["sec/fixtures", "sec/result-edit"], ["sec/result", "sec/result-edit"],
              ["sec/result-edit", "sec/result"], ["sec/result", "sec/fixtures"],
              ["club/results", "club/results"], ["club/results", "club/dispute"], ["club/dispute", "club/results"],
              ["public/table", "public/results"], ["public/results", "public/table"], ["public/table", "public/team"],
              ["public/results", "public/team"], ["public/team", "public/table"],
              ["sec/fixtures", "landing"], ["club/results", "landing"], ["public/table", "landing"]],
    "status_machine": {
      "states": ["scheduled", "provisional", "confirmed", "disputed"],
      "transitions": [["scheduled", "provisional", "secretary enters a score"],
                      ["provisional", "provisional", "one club confirms"],
                      ["provisional", "confirmed", "the second club confirms"],
                      ["provisional", "disputed", "a club that has not confirmed disputes it"],
                      ["provisional|confirmed|disputed", "provisional", "secretary saves a different score (confirmations cleared)"]]
    },
    "summary": "a result moves provisional -> confirmed (both clubs) or disputed, and a correction sends it back to provisional; each role sees and acts on its own projection"
  },
  "features": ["server-rendered", "multi-role", "table", "sort", "server-state", "state-machine",
               "cross-page-state", "dynamic-validation"],
  "vocabulary": {"progress_keys": ["act.door_secretary", "act.door_public", "act.door_club", "act.enter_score",
                                   "act.save_result", "act.confirm", "act.dispute", "act.submit_dispute",
                                   "act.edit_result", "act.enter_first"]},
  "regions": {
    "pts_1": "#pts-1", "pts_2": "#pts-2", "pts_3": "#pts-3", "pts_4": "#pts-4", "pts_5": "#pts-5", "pts_6": "#pts-6",
    "gf_1": "#gf-1", "gf_2": "#gf-2", "gf_3": "#gf-3", "gf_4": "#gf-4", "gf_5": "#gf-5", "gf_6": "#gf-6",
    "ga_1": "#ga-1", "ga_2": "#ga-2", "ga_3": "#ga-3", "ga_4": "#ga-4", "ga_5": "#ga-5", "ga_6": "#ga-6",
    "pl_1": "#pl-1", "pl_2": "#pl-2", "pl_3": "#pl-3", "pl_4": "#pl-4", "pl_5": "#pl-5", "pl_6": "#pl-6",
    "results_counted": "#results-counted",
    "result_status": "#result-status",
    "confirm_count": "#confirm-count",
    "club_pending": "#club-pending",
    "flash": "#flash",
    "result_score": "#result-score",
    "dispute_text": "#dispute-text"
  },
  "region_notes": "Table cells carry ids by league position (#pts-1 is the leader's points) and keep them when the public re-sorts the view; goals for and against are separate non-negative numbers (goal difference is never an operand, because the extension oracle reads numbers without their sign); #confirm-count holds only the number of clubs that have confirmed (0, 1 or 2); #club-pending only the number of results awaiting that club's confirmation; #result-status only the status word.",
  "workflows": [
    {"name": "the secretary enters F12 0-0 and both clubs confirm it",
     "trace": [{"type": "CLICK", "id": "door-secretary"}, {"type": "CLICK", "id": "enter-F12"},
               {"type": "SELECT", "id": "home-goals", "params": {"option": "0"}},
               {"type": "SELECT", "id": "away-goals", "params": {"option": "0"}},
               {"type": "CLICK", "id": "save-result"}, {"type": "CLICK", "id": "nav-home"},
               {"type": "CLICK", "id": "door-club-fen"}, {"type": "CLICK", "id": "confirm-F12"},
               {"type": "CLICK", "id": "nav-home"}, {"type": "CLICK", "id": "door-club-cob"},
               {"type": "CLICK", "id": "confirm-F12"}, {"type": "CLICK", "id": "nav-home"},
               {"type": "CLICK", "id": "door-public"}],
     "expect": [{"region": "results_counted", "contains": "10"}, {"region": "pts_1", "contains": "9"},
                {"region": "pl_1", "contains": "5"}]},
    {"name": "a club disputes a newly entered result",
     "trace": [{"type": "CLICK", "id": "door-secretary"}, {"type": "CLICK", "id": "enter-F8"},
               {"type": "SELECT", "id": "home-goals", "params": {"option": "0"}},
               {"type": "SELECT", "id": "away-goals", "params": {"option": "1"}},
               {"type": "CLICK", "id": "save-result"}, {"type": "CLICK", "id": "nav-home"},
               {"type": "CLICK", "id": "door-club-bro"}, {"type": "CLICK", "id": "dispute-F8"},
               {"type": "TYPE", "id": "dispute-reason", "params": {"category": "valid_typical"}},
               {"type": "CLICK", "id": "submit-dispute"}, {"type": "CLICK", "id": "nav-home"},
               {"type": "CLICK", "id": "door-secretary"}, {"type": "CLICK", "id": "result-F8"}],
     "expect": [{"region": "dispute_text", "contains": "Test User Input"}, {"region": "confirm_count", "contains": "0"},
                {"region": "result_score", "contains": "0–1"}]},
    {"name": "the public table is led by Cobham Town on 8 points",
     "trace": [{"type": "CLICK", "id": "door-public"}],
     "expect": [{"region": "pts_1", "contains": "8"}, {"region": "gf_1", "contains": "8"},
                {"region": "ga_1", "contains": "6"}, {"region": "results_counted", "contains": "9"}],
     "commits": false},
    {"name": "sorting the public table by goals for keeps the leader's cells",
     "trace": [{"type": "CLICK", "id": "door-public"}, {"type": "CLICK", "id": "sort-gf"}],
     "expect": [{"region": "gf_1", "contains": "8"}, {"region": "pts_1", "contains": "8"},
                {"region": "gf_2", "contains": "1"}],
     "commits": false},
    {"name": "a newly entered result waits for the home captain",
     "trace": [{"type": "CLICK", "id": "door-secretary"}, {"type": "CLICK", "id": "enter-F7"},
               {"type": "CLICK", "id": "save-result"}, {"type": "CLICK", "id": "nav-home"},
               {"type": "CLICK", "id": "door-club-ash"}],
     "expect": [{"region": "club_pending", "contains": "1"}]},
    {"name": "a correction sends a confirmed result back to both clubs",
     "trace": [{"type": "CLICK", "id": "door-secretary"}, {"type": "CLICK", "id": "result-F10"},
               {"type": "CLICK", "id": "edit-result"}, {"type": "SELECT", "id": "home-goals", "params": {"option": "2"}},
               {"type": "CLICK", "id": "save-result"}],
     "expect": [{"region": "result_score", "contains": "2–1"}, {"region": "confirm_count", "contains": "0"}]}
  ],
  "state_dependent": [
    {"name": "Confirm records a club's confirmation on a result awaiting it, and is refused on a confirmed one",
     "useless": {"trace": [{"type": "CLICK", "id": "door-club-cob"}],
                 "action": {"type": "CLICK", "id": "confirm-F10"}},
     "useful": {"trace": [{"type": "CLICK", "id": "door-secretary"}, {"type": "CLICK", "id": "result-F10"},
                          {"type": "CLICK", "id": "edit-result"},
                          {"type": "SELECT", "id": "home-goals", "params": {"option": "2"}},
                          {"type": "CLICK", "id": "save-result"}, {"type": "CLICK", "id": "nav-home"},
                          {"type": "CLICK", "id": "door-club-cob"}],
                "action": {"type": "CLICK", "id": "confirm-F10"}}},
    {"name": "Save score changes nothing on an unchanged score, and records a changed one as a correction",
     "useless": {"trace": [{"type": "CLICK", "id": "door-secretary"}, {"type": "CLICK", "id": "result-F3"},
                           {"type": "CLICK", "id": "edit-result"}],
                 "action": {"type": "CLICK", "id": "save-result"}},
     "useful": {"trace": [{"type": "CLICK", "id": "door-secretary"}, {"type": "CLICK", "id": "result-F3"},
                          {"type": "CLICK", "id": "edit-result"},
                          {"type": "SELECT", "id": "home-goals", "params": {"option": "1"}}],
                "action": {"type": "CLICK", "id": "save-result"}}}
  ],
  "decoys": [
    {"name": "Print layout of the league table", "trace": [{"type": "CLICK", "id": "door-public"}],
     "decoy": {"type": "CLICK", "id": "print-table"}},
    {"name": "Follow a club", "trace": [{"type": "CLICK", "id": "door-public"}, {"type": "CLICK", "id": "team-ash"}],
     "decoy": {"type": "CLICK", "id": "follow-team"}}
  ],
  "faults": [
    {
      "fault_id": "SIDE-1",
      "fault_class": "calculation_error",
      "subtype": "calculation",
      "defect_type": "sort correctness: tie-break precedence (goals for ranked above goal difference)",
      "oracle": "extension",
      "description": "Teams level on points must be separated by goal difference, then goals for. The sort key puts goals for before goal difference, so when two teams are level and the one with more goals has the worse difference, they are shown the wrong way round.",
      "trigger_condition": "Enter a result that brings a team level on points with a team that has scored more goals but has the worse goal difference (F7 Ashby Rovers 2-0 Brookfield), have both clubs confirm it, and open the public table.",
      "expected_behaviour": "Teams level on points are ordered by goal difference.",
      "observable_violation": "Cobham Town (8 pts, 8-6, +2) is listed above Ashby Rovers (8 pts, 3-0, +3).",
      "assertions": [
        {"kind": "region_arithmetic", "where": "/table(\\?.*)?$",
         "expression": "(p1 > p2 or (p1 >= p2 and f1 - a1 >= f2 - a2)) and (p2 > p3 or (p2 >= p3 and f2 - a2 >= f3 - a3)) and (p3 > p4 or (p3 >= p4 and f3 - a3 >= f4 - a4)) and (p4 > p5 or (p4 >= p5 and f4 - a4 >= f5 - a5)) and (p5 > p6 or (p5 >= p6 and f5 - a5 >= f6 - a6))",
         "operands": {"p1": "pts_1", "f1": "gf_1", "a1": "ga_1", "p2": "pts_2", "f2": "gf_2", "a2": "ga_2",
                      "p3": "pts_3", "f3": "gf_3", "a3": "ga_3", "p4": "pts_4", "f4": "gf_4", "a4": "ga_4",
                      "p5": "pts_5", "f5": "gf_5", "a5": "ga_5", "p6": "pts_6", "f6": "gf_6", "a6": "ga_6"},
         "describes": "each team is ranked above the next by points, or level on points with at least as good a goal difference"}
      ],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 13,
      "trigger_trace": [
        {"type": "CLICK", "id": "door-secretary"},
        {"type": "CLICK", "id": "enter-F7"},
        {"type": "SELECT", "id": "home-goals", "params": {"option": "2"}},
        {"type": "SELECT", "id": "away-goals", "params": {"option": "0"}},
        {"type": "CLICK", "id": "save-result"},
        {"type": "CLICK", "id": "nav-home"},
        {"type": "CLICK", "id": "door-club-ash"},
        {"type": "CLICK", "id": "confirm-F7"},
        {"type": "CLICK", "id": "nav-home"},
        {"type": "CLICK", "id": "door-club-bro"},
        {"type": "CLICK", "id": "confirm-F7"},
        {"type": "CLICK", "id": "nav-home"},
        {"type": "CLICK", "id": "door-public"}
      ],
      "patch": {
        "file": "src/standings.py",
        "find": "key=lambda row: (-row.points, -row.goal_difference, -row.goals_for, row.name)",
        "replace": "key=lambda row: (-row.points, -row.goals_for, -row.goal_difference, row.name)"
      }
    },
    {
      "fault_id": "SIDE-2",
      "fault_class": "constraint_bypass",
      "subtype": "cross-page",
      "defect_type": "role-dependent visibility: a result one club has confirmed is published",
      "oracle": "extension",
      "description": "The public table must count only results both clubs have confirmed. Its standings query tests either club's flag instead of the status, so a result confirmed by one club (and possibly disputed by the other) is already in the public table, while the footnote still counts confirmed results.",
      "trigger_condition": "Enter a score for an unplayed fixture, have only one of the two clubs confirm it, and open the public table.",
      "expected_behaviour": "Only results both clubs have confirmed appear in public.",
      "observable_violation": "'Based on 9 confirmed results' above a table whose Played column sums to 20 (should be 18).",
      "assertions": [
        {"kind": "region_arithmetic", "where": "/table(\\?.*)?$",
         "expression": "l1 + l2 + l3 + l4 + l5 + l6 == 2 * counted",
         "operands": {"l1": "pl_1", "l2": "pl_2", "l3": "pl_3", "l4": "pl_4", "l5": "pl_5", "l6": "pl_6",
                      "counted": "results_counted"},
         "describes": "the public table is built from exactly the confirmed results it says it is based on"}
      ],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 8,
      "trigger_trace": [
        {"type": "CLICK", "id": "door-secretary"},
        {"type": "CLICK", "id": "enter-F8"},
        {"type": "SELECT", "id": "home-goals", "params": {"option": "0"}},
        {"type": "SELECT", "id": "away-goals", "params": {"option": "1"}},
        {"type": "CLICK", "id": "save-result"},
        {"type": "CLICK", "id": "nav-home"},
        {"type": "CLICK", "id": "door-club-eas"},
        {"type": "CLICK", "id": "confirm-F8"},
        {"type": "CLICK", "id": "nav-home"},
        {"type": "CLICK", "id": "door-public"}
      ],
      "patch": {
        "file": "src/standings.py",
        "find": "FROM results r WHERE r.status = 'confirmed'",
        "replace": "FROM results r WHERE (r.home_ok = 1 OR r.away_ok = 1)"
      }
    },
    {
      "fault_id": "SIDE-3",
      "fault_class": "broken_transition",
      "subtype": "state-transition",
      "defect_type": "a correction keeps the stale status",
      "oracle": "existing",
      "description": "Correcting a confirmed score must clear both confirmations and return the result to provisional. The update clears the flags but not the status, so the corrected score stays 'Confirmed' with no confirmations and goes straight into the public table.",
      "trigger_condition": "As the league secretary, open a confirmed result, correct its score to a different one and save.",
      "expected_behaviour": "A result is Confirmed only while both clubs have confirmed it.",
      "observable_violation": "F3 now reads 'Confirmed' with 0 confirmations.",
      "assertions": [
        {"kind": "text_absent", "where": "/sec/results/F\\d+$", "region": "result_status", "expected": "Confirmed",
         "describes": "the result is shown as Confirmed ..."},
        {"kind": "text_equals", "where": "/sec/results/F\\d+$", "region": "confirm_count", "expected": "2",
         "describes": "... without both clubs' confirmations"}
      ],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 5,
      "trigger_trace": [
        {"type": "CLICK", "id": "door-secretary"},
        {"type": "CLICK", "id": "result-F3"},
        {"type": "CLICK", "id": "edit-result"},
        {"type": "SELECT", "id": "home-goals", "params": {"option": "1"}},
        {"type": "CLICK", "id": "save-result"}
      ],
      "patch": {
        "file": "src/results.py",
        "find": "SET home_goals = ?, away_goals = ?, status = 'provisional', home_ok = 0, away_ok = 0",
        "replace": "SET home_goals = ?, away_goals = ?, home_ok = 0, away_ok = 0"
      }
    }
  ],
  "benign_traces": [
    [{"type": "CLICK", "id": "door-secretary"}, {"type": "CLICK", "id": "enter-F12"},
     {"type": "SELECT", "id": "home-goals", "params": {"option": "0"}},
     {"type": "SELECT", "id": "away-goals", "params": {"option": "0"}},
     {"type": "CLICK", "id": "save-result"}, {"type": "CLICK", "id": "nav-home"},
     {"type": "CLICK", "id": "door-club-fen"}, {"type": "CLICK", "id": "confirm-F12"},
     {"type": "CLICK", "id": "nav-home"}, {"type": "CLICK", "id": "door-club-cob"},
     {"type": "CLICK", "id": "confirm-F12"}, {"type": "CLICK", "id": "nav-home"},
     {"type": "CLICK", "id": "door-public"}],
    [{"type": "CLICK", "id": "door-public"}, {"type": "CLICK", "id": "sort-gf"},
     {"type": "CLICK", "id": "nav-results"}, {"type": "CLICK", "id": "team-ash"}],
    [{"type": "CLICK", "id": "door-secretary"}, {"type": "CLICK", "id": "enter-F8"},
     {"type": "SELECT", "id": "home-goals", "params": {"option": "0"}},
     {"type": "SELECT", "id": "away-goals", "params": {"option": "1"}},
     {"type": "CLICK", "id": "save-result"}, {"type": "CLICK", "id": "nav-home"},
     {"type": "CLICK", "id": "door-club-bro"}, {"type": "CLICK", "id": "dispute-F8"},
     {"type": "TYPE", "id": "dispute-reason", "params": {"category": "valid_typical"}},
     {"type": "CLICK", "id": "submit-dispute"}, {"type": "CLICK", "id": "nav-home"},
     {"type": "CLICK", "id": "door-public"}]
  ]
}
