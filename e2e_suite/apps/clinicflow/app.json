          }
        },
        {
          "type": "SELECT",
          "id": "payment",
          "params": {
            "option": "self"
          }
        },
        {
          "type": "CLICK",
          "id": "find-record"
        },
        {
          "type": "CLICK",
          "id": "hold-0611-1100"
        },
        {
          "type": "CLICK",
          "id": "slots-done"
        },
        {
          "type": "CLICK",
          "id": "book-visit"
        },
        {
