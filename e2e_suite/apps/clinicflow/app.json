  "faults": [
    {
      "fault_id": "CLIN-1",
      "fault_class": "state_corruption",
      "subtype": "stale-state",
      "oracle": "extension",
      "description": "Completing a reschedule reads the appointment's current time only after the appointment has been moved, so the release step looks for the old booking at the new time, finds nothing, and the old time stays occupied: the practitioner's week keeps a phantom 'Booked' slot that no appointment owns.",
      "trigger_condition": "Book an appointment, reschedule it to a different time and confirm, then open the slot table for that practitioner again.",
      "expected_behaviour": "On every slot table, the times taken equal those taken by other patients plus the times this patient holds or has booked.",
      "observable_violation": "After one reschedule the table shows Taken 8, Taken by other patients 6, Yours 1.",
      "assertions": [
        {
          "kind": "region_arithmetic",
          "where": "/book/\\d+/slots",
          "expression": "taken == others + yours",
          "operands": {
            "taken": "taken",
            "others": "others",
            "yours": "yours"
          },
          "describes": "every taken time belongs to another patient or to this patient"
        }
      ],
      "reproduction": {
        "replays": 2,
        "must_all_reproduce": true
      },
      "observation_horizon": 1,
      "shortest_path": 15,
      "trigger_trace": [
        {
          "type": "CLICK",
          "id": "nav-book"
        },
        {
          "type": "CLICK",
          "id": "svc-gp"
        },
