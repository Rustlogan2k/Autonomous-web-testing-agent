{
  "app_id": "clinicflow",
  "name": "Clinicflow (Harbourside Health)",
  "domain": "healthcare appointment booking",
  "user_goal": "Book a GP, physiotherapy or nurse appointment as a new or returning patient, answer the pre-visit questions when the service needs them, then reschedule or cancel it.",
  "architecture": "server-rendered-branching-wizard+client-conditionals",
  "stack": "python-stdlib-wsgiref+sqlite",
  "persistence": "one sqlite file per session; the booking draft is a server-side row addressed in the URL",
  "entry": "/",
  "start": [
    "python",
    "src/server.py"
  ],
  "dockerfile": true,
  "workflow_graph": {
    "kind": [
      "branching",
      "linear-wizard",
      "revisit"
    ],
    "nodes": [
      "home",
      "service",
      "who",
      "details",
      "lookup",
      "slots",
      "questions",
      "confirm",
      "booked",
      "manage",
      "bookings",
      "replaced"
    ],
    "edges": [
      [
        "home",
        "service"
      ],
