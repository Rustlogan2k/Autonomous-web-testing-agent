      [
        "manage",
        "slots"
      ],
      [
        "confirm",
        "manage"
      ],
      [
        "manage",
        "bookings"
      ],
      [
        "bookings",
        "manage"
      ],
      [
        "home",
        "bookings"
      ],
      [
        "service",
        "replaced"
