{
  "app_id": "ledgerly",
  "name": "Ledgerly",
  "domain": "expense claims",
  "user_goal": "Draft an expense claim with lines in several currencies, lodge it, and take it through manager approval, send-back and resubmission, or escalation to finance.",
  "architecture": "node-server-rendered+client-form-island",
  "stack": "node22+pg-driver+postgresql",
  "persistence": "postgresql schema per signed-in session; claims are append-only line revisions and events, their status the fold of the events; merchants and cost centres are ordinary rows",
  "entry": "/",
  "start": ["node", "src/server.js"],
  "dockerfile": true,
  "workflow_graph": {
    "kind": [
      "branching",
      "data-grid",
      "hub-and-spoke",
      "modal-heavy",
      "nested-form",
      "revisit",
      "state-machine"
    ],
    "nodes": [
      "my-claims",
      "claim-editor",
      "claim",
      "approval-queue",
      "finance-queue",
      "receipt-panel",
      "claim-states:draft",
      "claim-states:awaiting",
      "claim-states:sent_back",
      "claim-states:with_finance",
      "claim-states:approved",
      "claim-states:rejected",
      "sign-in",
      "forgot-password",
      "merchants",
      "merchant",
      "merchant-form",
      "cost-centres",
      "reports",
      "discard-dialog",
      "delete-dialog",
      "access-notice"
    ],
    "edges": [
      ["my-claims", "claim-editor"],
      ["claim-editor", "claim-editor"],
      ["claim-editor", "receipt-panel"],
      ["claim-editor", "claim"],
      ["my-claims", "claim"],
      ["claim", "claim-editor"],
      ["claim", "my-claims"],
      ["approval-queue", "claim"],
      ["finance-queue", "claim"],
      ["claim", "claim"],
      ["my-claims", "approval-queue"],
      ["approval-queue", "finance-queue"],
      ["finance-queue", "my-claims"],
      ["claim-states:draft", "claim-states:draft"],
      ["claim-states:draft", "claim-states:awaiting"],
      ["claim-states:awaiting", "claim-states:approved"],
      ["claim-states:awaiting", "claim-states:sent_back"],
      ["claim-states:awaiting", "claim-states:with_finance"],
      ["claim-states:sent_back", "claim-states:sent_back"],
      ["claim-states:sent_back", "claim-states:awaiting"],
      ["claim-states:with_finance", "claim-states:approved"],
      ["claim-states:with_finance", "claim-states:rejected"],
      ["sign-in", "my-claims"],
      ["sign-in", "sign-in"],
      ["sign-in", "forgot-password"],
      ["forgot-password", "sign-in"],
      ["my-claims", "my-claims"],
      ["claim", "discard-dialog"],
      ["discard-dialog", "my-claims"],
      ["discard-dialog", "claim"],
      ["my-claims", "merchants"],
      ["merchants", "merchants"],
      ["merchants", "merchant"],
      ["merchant", "merchant-form"],
      ["merchants", "merchant-form"],
      ["merchant-form", "merchant"],
      ["merchant-form", "delete-dialog"],
      ["delete-dialog", "merchants"],
      ["my-claims", "cost-centres"],
      ["cost-centres", "cost-centres"],
      ["cost-centres", "delete-dialog"],
      ["delete-dialog", "cost-centres"],
      ["my-claims", "reports"],
      ["approval-queue", "approval-queue"],
      ["access-notice", "my-claims"]
    ]
  },
  "features": [
    "bulk-operation",
    "client-state",
    "dynamic-validation",
    "enable-disable",
    "filter",
    "modal",
    "multi-role",
    "nested-form",
    "server-rendered",
    "server-state",
    "sort",
    "table",
    "tabs"
  ],
  "vocabulary": {
    "progress_keys": [
      "act.add_centre",
      "act.approve",
      "act.approve_selected",
      "act.confirm_delete",
      "act.confirm_discard",
      "act.escalate",
      "act.lodge",
      "act.new_claim",
      "act.resubmit",
      "act.save_changes",
      "act.save_draft",
      "act.save_merchant",
      "act.send_back",
      "act.switch_role"
    ]
  },
  "regions": {
    "my_claims": "#my-claims",
    "approval_queue": "#approval-queue",
    "finance_queue": "#finance-queue",
    "claim_notice": "#claim-notice",
    "claim_error": "#claim-error",
    "claim_status": "#claim-status",
    "claim_approver": "#claim-approver",
    "claim_total": "#claim-total",
    "claim_lines": "#claim-lines",
    "claim_latest": "#claim-latest",
    "editor_notice": "#editor-notice",
    "editor_errors": "#editor-errors",
    "sum_gbp": "#sum-gbp",
    "sum_eur": "#sum-eur",
    "sum_usd": "#sum-usd",
    "sum_total": "#sum-total",
    "signed_in_as": "#signed-in-as",
    "login_error": "#login-error",
    "access_notice": "#access-notice",
    "claim_history": "#claim-history",
    "claims_shown": "#claims-shown",
    "claims_sort": "#claims-sort",
    "row_1_total": "#row-1-total",
    "row_2_total": "#row-2-total",
    "claims_notice": "#claims-notice",
    "queue_notice": "#queue-notice",
    "merchants_total": "#merchants-total",
    "merchants_list": "#merchants-list",
    "merchants_page": "#merchants-page",
    "merchants_pages": "#merchants-pages",
    "merchants_notice": "#merchants-notice",
    "merchant_name": "#merchant-name",
    "merchant_city": "#merchant-city",
    "cost_centre_list": "#cost-centre-list",
    "centres_notice": "#centres-notice",
    "report_categories": "#report-categories"
  },
  "workflows": [
    {
      "name": "lodge a claim in pounds and euros",
      "trace": [
        {"type": "CLICK", "id": "new-claim"},
        {"type": "TYPE", "id": "description-1", "params": {"category": "valid_typical"}},
        {"type": "TYPE", "id": "amount-1", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "add-line"},
        {"type": "TYPE", "id": "description-2", "params": {"category": "valid_typical"}},
        {"type": "SELECT", "id": "currency-2", "params": {"option": "EUR"}},
        {"type": "TYPE", "id": "amount-2", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "lodge-claim"}
      ],
      "expect": [
        {"region": "claim_total", "contains": "78.12"},
        {"region": "claim_lines", "contains": "36.12"}
      ]
    },
    {
      "name": "the manager approves a small claim",
      "trace": [
        {"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
        {"type": "CLICK", "id": "switch-role"},
        {"type": "CLICK", "id": "open-CL-102"},
        {"type": "CLICK", "id": "approve-claim"}
      ],
      "expect": [
        {"region": "claim_approver", "contains": "Ben Okafor"},
        {"region": "claim_total", "contains": "18.40"}
      ]
    },
    {
      "name": "the manager escalates a claim over the limit and finance approves it",
      "trace": [
        {"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
        {"type": "CLICK", "id": "switch-role"},
        {"type": "CLICK", "id": "open-CL-103"},
        {"type": "CLICK", "id": "escalate"},
        {"type": "SELECT", "id": "viewing-as", "params": {"option": "finance"}},
        {"type": "CLICK", "id": "switch-role"},
        {"type": "CLICK", "id": "open-CL-103"},
        {"type": "CLICK", "id": "approve-claim"}
      ],
      "expect": [
        {"region": "claim_approver", "contains": "Finance desk"},
        {"region": "claim_total", "contains": "64.00"}
      ]
    },
    {
      "name": "the manager sends a claim back with a note",
      "trace": [
        {"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
        {"type": "CLICK", "id": "switch-role"},
        {"type": "CLICK", "id": "open-CL-102"},
        {"type": "TYPE", "id": "decision-note", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "send-back"}
      ],
      "expect": [
        {"region": "claim_latest", "contains": "Test User Input"},
        {"region": "claim_approver", "absent": "Ben Okafor"}
      ]
    },
    {
      "name": "a sent-back claim is resubmitted and is back in the manager's queue",
      "trace": [
        {"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
        {"type": "CLICK", "id": "switch-role"},
        {"type": "CLICK", "id": "open-CL-102"},
        {"type": "TYPE", "id": "decision-note", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "send-back"},
        {"type": "SELECT", "id": "viewing-as", "params": {"option": "ana"}},
        {"type": "CLICK", "id": "switch-role"},
        {"type": "CLICK", "id": "claim-CL-102"},
        {"type": "CLICK", "id": "edit-claim"},
        {"type": "CLICK", "id": "resubmit-claim"},
        {"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
        {"type": "CLICK", "id": "switch-role"}
      ],
      "expect": [
        {"region": "approval_queue", "contains": "CL-102"},
        {"region": "approval_queue", "contains": "18.40"}
      ]
    },
    {
      "name": "the editor's live summary converts dollars",
      "trace": [
        {"type": "CLICK", "id": "new-claim"},
        {"type": "SELECT", "id": "currency-1", "params": {"option": "USD"}},
        {"type": "TYPE", "id": "amount-1", "params": {"category": "valid_typical"}}
      ],
      "expect": [
        {"region": "sum_usd", "contains": "42.00"},
        {"region": "sum_total", "contains": "33.18"}
      ],
      "commits": false
    },
    {
      "name": "remove a line before lodging",
      "trace": [
        {"type": "CLICK", "id": "new-claim"},
        {"type": "TYPE", "id": "description-1", "params": {"category": "valid_typical"}},
        {"type": "TYPE", "id": "amount-1", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "add-line"},
        {"type": "TYPE", "id": "description-2", "params": {"category": "valid_typical"}},
        {"type": "TYPE", "id": "amount-2", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "remove-line-2"},
        {"type": "CLICK", "id": "lodge-claim"}
      ],
      "expect": [
        {"region": "claim_total", "contains": "42.00"},
        {"region": "claim_lines", "contains": "Test User Input"}
      ]
    },
    {
      "name": "sort my claims by total",
      "trace": [
        {"type": "CLICK", "id": "sort-total"}
      ],
      "expect": [
        {"region": "row_1_total", "contains": "18.40"},
        {"region": "row_2_total", "contains": "38.50"}
      ],
      "commits": false
    },
    {
      "name": "show only the claims awaiting approval",
      "trace": [
        {"type": "CLICK", "id": "filter-awaiting"}
      ],
      "expect": [
        {"region": "claims_shown", "contains": "2"}
      ],
      "commits": false
    },
    {
      "name": "discard a draft claim",
      "trace": [
        {"type": "CLICK", "id": "new-claim"},
        {"type": "TYPE", "id": "description-1", "params": {"category": "valid_typical"}},
        {"type": "TYPE", "id": "amount-1", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "save-draft"},
        {"type": "CLICK", "id": "discard-claim"},
        {"type": "CLICK", "id": "confirm-discard"}
      ],
      "expect": [
        {"region": "my_claims", "absent": "CL-104"},
        {"region": "claims_notice", "contains": "CL-104"}
      ],
      "commits": false
    },
    {
      "name": "read a claim's history",
      "trace": [
        {"type": "CLICK", "id": "claim-CL-101"},
        {"type": "CLICK", "id": "tab-history"}
      ],
      "expect": [
        {"region": "claim_history", "contains": "Ben Okafor"}
      ],
      "commits": false
    },
    {
      "name": "the manager approves claims in bulk",
      "trace": [
        {"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
        {"type": "CLICK", "id": "switch-role"},
        {"type": "CLICK", "id": "pick-CL-102"},
        {"type": "CLICK", "id": "pick-CL-103"},
        {"type": "CLICK", "id": "approve-selected"}
      ],
      "expect": [
        {"region": "approval_queue", "absent": "CL-102"},
        {"region": "approval_queue", "contains": "CL-103"}
      ]
    },
    {
