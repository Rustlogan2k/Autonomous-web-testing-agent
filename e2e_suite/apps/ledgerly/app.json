{
  "app_id": "ledgerly",
  "name": "Ledgerly",
  "domain": "expense claims",
  "user_goal": "Draft an expense claim with lines in several currencies, lodge it, and take it through manager approval, send-back and resubmission, or escalation to finance.",
  "architecture": "node-server-rendered+client-form-island",
  "stack": "node-builtins+json-files",
  "persistence": "append-only event log per session (JSON lines), folded over the seed on every request; nothing is ever rewritten",
  "entry": "/",
  "start": ["node", "src/server.js"],
  "dockerfile": true,
  "workflow_graph": {
    "kind": ["nested-form", "branching", "revisit", "state-machine"],
    "nodes": ["my-claims", "claim-editor", "claim", "approval-queue", "finance-queue", "receipt-panel",
              "claim-states:draft", "claim-states:awaiting", "claim-states:sent_back",
              "claim-states:with_finance", "claim-states:approved", "claim-states:rejected"],
    "edges": [["my-claims", "claim-editor"], ["claim-editor", "claim-editor"], ["claim-editor", "receipt-panel"],
              ["claim-editor", "claim"], ["my-claims", "claim"], ["claim", "claim-editor"], ["claim", "my-claims"],
              ["approval-queue", "claim"], ["finance-queue", "claim"], ["claim", "claim"],
              ["my-claims", "approval-queue"], ["approval-queue", "finance-queue"], ["finance-queue", "my-claims"],
              ["claim-states:draft", "claim-states:draft"], ["claim-states:draft", "claim-states:awaiting"],
              ["claim-states:awaiting", "claim-states:approved"], ["claim-states:awaiting", "claim-states:sent_back"],
              ["claim-states:awaiting", "claim-states:with_finance"], ["claim-states:sent_back", "claim-states:sent_back"],
              ["claim-states:sent_back", "claim-states:awaiting"], ["claim-states:with_finance", "claim-states:approved"],
              ["claim-states:with_finance", "claim-states:rejected"]]
  },
  "features": ["nested-form", "multi-role", "server-rendered", "client-state", "server-state",
               "dynamic-validation", "table", "enable-disable"],
  "vocabulary": {"progress_keys": ["act.lodge", "act.resubmit", "act.approve", "act.send_back", "act.escalate",
                                   "act.save_draft", "act.save_changes", "act.switch_role", "act.new_claim"]},
  "regions": {
    "my_claims": "#my-claims",
    "approval_queue": "#approval-queue",
    "finance_queue": "#finance-queue",
    "claim_notice": "#claim-notice",
    "claim_error": "#claim-error",
    "claim_status": "#claim-status",
    "claim_approver": "#claim-approver",
    "claim_total": "#claim-total",
    "claim_lines": "#claim-lines",
    "claim_latest": "#claim-latest",
    "editor_notice": "#editor-notice",
    "editor_errors": "#editor-errors",
    "sum_gbp": "#sum-gbp",
    "sum_eur": "#sum-eur",
    "sum_usd": "#sum-usd",
    "sum_total": "#sum-total"
  },
  "workflows": [
    {"name": "lodge a claim in pounds and euros",
     "trace": [{"type": "CLICK", "id": "new-claim"},
               {"type": "TYPE", "id": "description-1", "params": {"category": "valid_typical"}},
               {"type": "TYPE", "id": "amount-1", "params": {"category": "valid_typical"}},
               {"type": "CLICK", "id": "add-line"},
               {"type": "TYPE", "id": "description-2", "params": {"category": "valid_typical"}},
               {"type": "SELECT", "id": "currency-2", "params": {"option": "EUR"}},
               {"type": "TYPE", "id": "amount-2", "params": {"category": "valid_typical"}},
               {"type": "CLICK", "id": "lodge-claim"}],
     "expect": [{"region": "claim_total", "contains": "78.12"},
                {"region": "claim_lines", "contains": "36.12"}]},
    {"name": "the manager approves a small claim",
     "trace": [{"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
               {"type": "CLICK", "id": "switch-role"},
               {"type": "CLICK", "id": "open-CL-102"},
               {"type": "CLICK", "id": "approve-claim"}],
     "expect": [{"region": "claim_approver", "contains": "Ben Okafor"},
                {"region": "claim_total", "contains": "18.40"}]},
    {"name": "the manager escalates a claim over the limit and finance approves it",
     "trace": [{"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
               {"type": "CLICK", "id": "switch-role"},
               {"type": "CLICK", "id": "open-CL-103"},
               {"type": "CLICK", "id": "escalate"},
               {"type": "SELECT", "id": "viewing-as", "params": {"option": "finance"}},
               {"type": "CLICK", "id": "switch-role"},
               {"type": "CLICK", "id": "open-CL-103"},
               {"type": "CLICK", "id": "approve-claim"}],
     "expect": [{"region": "claim_approver", "contains": "Finance desk"},
                {"region": "claim_total", "contains": "64.00"}]},
    {"name": "the manager sends a claim back with a note",
     "trace": [{"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
               {"type": "CLICK", "id": "switch-role"},
               {"type": "CLICK", "id": "open-CL-102"},
               {"type": "TYPE", "id": "decision-note", "params": {"category": "valid_typical"}},
               {"type": "CLICK", "id": "send-back"}],
     "expect": [{"region": "claim_latest", "contains": "Test User Input"},
                {"region": "claim_approver", "absent": "Ben Okafor"}]},
    {"name": "a sent-back claim is resubmitted and is back in the manager's queue",
     "trace": [{"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
               {"type": "CLICK", "id": "switch-role"},
               {"type": "CLICK", "id": "open-CL-102"},
               {"type": "TYPE", "id": "decision-note", "params": {"category": "valid_typical"}},
               {"type": "CLICK", "id": "send-back"},
               {"type": "SELECT", "id": "viewing-as", "params": {"option": "ana"}},
               {"type": "CLICK", "id": "switch-role"},
               {"type": "CLICK", "id": "claim-CL-102"},
               {"type": "CLICK", "id": "edit-claim"},
               {"type": "CLICK", "id": "resubmit-claim"},
               {"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
               {"type": "CLICK", "id": "switch-role"}],
     "expect": [{"region": "approval_queue", "contains": "CL-102"},
                {"region": "approval_queue", "contains": "18.40"}]},
    {"name": "the editor's live summary converts dollars",
     "trace": [{"type": "CLICK", "id": "new-claim"},
               {"type": "SELECT", "id": "currency-1", "params": {"option": "USD"}},
               {"type": "TYPE", "id": "amount-1", "params": {"category": "valid_typical"}}],
     "expect": [{"region": "sum_usd", "contains": "42.00"},
                {"region": "sum_total", "contains": "33.18"}],
     "commits": false},
    {"name": "remove a line before lodging",
     "trace": [{"type": "CLICK", "id": "new-claim"},
               {"type": "TYPE", "id": "description-1", "params": {"category": "valid_typical"}},
               {"type": "TYPE", "id": "amount-1", "params": {"category": "valid_typical"}},
               {"type": "CLICK", "id": "add-line"},
               {"type": "TYPE", "id": "description-2", "params": {"category": "valid_typical"}},
               {"type": "TYPE", "id": "amount-2", "params": {"category": "valid_typical"}},
               {"type": "CLICK", "id": "remove-line-2"},
               {"type": "CLICK", "id": "lodge-claim"}],
     "expect": [{"region": "claim_total", "contains": "42.00"},
                {"region": "claim_lines", "contains": "Test User Input"}]}
  ],
  "state_dependent": [
    {"name": "the manager's Approve approves a claim within the £50 limit and is refused above it",
     "useless": {"trace": [{"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
                           {"type": "CLICK", "id": "switch-role"},
                           {"type": "CLICK", "id": "open-CL-103"}],
                 "action": {"type": "CLICK", "id": "approve-claim"}},
     "useful": {"trace": [{"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
                          {"type": "CLICK", "id": "switch-role"},
                          {"type": "CLICK", "id": "open-CL-102"}],
                "action": {"type": "CLICK", "id": "approve-claim"}}},
    {"name": "Lodge claim is refused while a line has no amount and lodges once it has one",
     "useless": {"trace": [{"type": "CLICK", "id": "new-claim"},
                           {"type": "TYPE", "id": "description-1", "params": {"category": "valid_typical"}}],
                 "action": {"type": "CLICK", "id": "lodge-claim"}},
     "useful": {"trace": [{"type": "CLICK", "id": "new-claim"},
                          {"type": "TYPE", "id": "description-1", "params": {"category": "valid_typical"}},
                          {"type": "TYPE", "id": "amount-1", "params": {"category": "valid_typical"}}],
                "action": {"type": "CLICK", "id": "lodge-claim"}}}
  ],
  "decoys": [
    {"name": "Save as template in the claim editor",
     "trace": [{"type": "CLICK", "id": "new-claim"},
               {"type": "TYPE", "id": "description-1", "params": {"category": "valid_typical"}},
               {"type": "TYPE", "id": "amount-1", "params": {"category": "valid_typical"}}],
     "decoy": {"type": "CLICK", "id": "save-template"}},
    {"name": "Attach receipt in the claim editor",
     "trace": [{"type": "CLICK", "id": "new-claim"}],
     "decoy": {"type": "CLICK", "id": "attach-receipt"}}
  ],
  "faults": [
    {
      "fault_id": "LED-1",
      "fault_class": "calculation_error",
      "subtype": "stale-state",
      "oracle": "extension",
      "description": "The claim editor totals the claim in sterling from a per-line cache of converted values. The cache is refreshed when an amount is typed but not when a line's currency is changed, so after switching a line from pounds to euros the per-currency sums move but 'Total in GBP' still counts the line at its old rate.",
      "trigger_condition": "In the claim editor, type an amount on a line, then change that line's currency.",
      "expected_behaviour": "The editor's Total in GBP always equals the pounds plus the euros at 0.86 plus the dollars at 0.79 shown beside it.",
      "observable_violation": "Pounds £0.00, Euros €42.00, Dollars $0.00, but Total in GBP £42.00 instead of £36.12.",
      "assertions": [{"kind": "region_arithmetic", "where": "/claims/(new|CL-\\d+/edit)$",
                      "expression": "total == round(gbp + eur * 0.86 + usd * 0.79, 2)", "tolerance": 0.011,
                      "operands": {"total": "sum_total", "gbp": "sum_gbp", "eur": "sum_eur", "usd": "sum_usd"},
                      "describes": "the editor's sterling total is the sum of its per-currency sums at the fixed rates"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 3,
      "trigger_trace": [
        {"type": "CLICK", "id": "new-claim"},
        {"type": "TYPE", "id": "description-1", "params": {"category": "valid_typical"}},
        {"type": "TYPE", "id": "amount-1", "params": {"category": "valid_typical"}},
        {"type": "SELECT", "id": "currency-1", "params": {"option": "EUR"}}],
      "patch": {"file": "src/static/claim-editor.js",
                "find": "row.querySelector(\"[data-currency]\").addEventListener(\"change\", () => { reprice(row); renderSummary(); });",
                "replace": "row.querySelector(\"[data-currency]\").addEventListener(\"change\", () => renderSummary());"}
    },
    {
      "fault_id": "LED-2",
      "fault_class": "broken_transition",
      "subtype": "workflow-completion",
      "oracle": "existing",
      "description": "The table that maps each event to the claim status it leads to has no entry for a resubmission, so resubmitting a sent-back claim records 'Resubmitted' in the history but leaves the claim 'Sent back': it never returns to the manager's queue.",
      "trigger_condition": "As the manager, send a claim back with a note; as the claimant, open it, edit it and resubmit it.",
      "expected_behaviour": "A resubmitted claim is awaiting the manager's approval again.",
      "observable_violation": "The claim page's latest entry is 'Resubmitted — Ana Ruiz' while its status still reads 'Sent back'.",
      "assertions": [
        {"kind": "text_absent", "where": "/claims/CL-\\d+$", "region": "claim_status", "expected": "Sent back",
         "describes": "the claim is not (still) sent back ..."},
        {"kind": "text_absent", "where": "/claims/CL-\\d+$", "region": "claim_latest", "expected": "Resubmitted",
         "describes": "... once its latest event is a resubmission"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 10,
      "trigger_trace": [
        {"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
        {"type": "CLICK", "id": "switch-role"},
        {"type": "CLICK", "id": "open-CL-102"},
        {"type": "TYPE", "id": "decision-note", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "send-back"},
        {"type": "SELECT", "id": "viewing-as", "params": {"option": "ana"}},
        {"type": "CLICK", "id": "switch-role"},
        {"type": "CLICK", "id": "claim-CL-102"},
        {"type": "CLICK", "id": "edit-claim"},
        {"type": "CLICK", "id": "resubmit-claim"}],
      "patch": {"file": "src/claims.js",
                "find": "  resubmitted: \"awaiting\", // back into the manager's queue\n",
                "replace": ""}
    },
    {
      "fault_id": "LED-3",
      "fault_class": "constraint_bypass",
      "subtype": "missing-validation",
      "oracle": "extension",
      "description": "The manager's £50 approval limit is checked against the claim's pound lines only; euro and dollar lines are not converted and counted, so a claim of £42 and €42 (£78.12 in all) can be approved by the manager without going to finance.",
      "trigger_condition": "Lodge a claim with a pound line and a euro line that together exceed £50 while the pound lines alone do not; as the manager, approve it.",
      "expected_behaviour": "A manager never approves a claim worth more than £50 in sterling; above that only finance approves.",
      "observable_violation": "The claim page shows 'Approved by Ben Okafor (manager)' with a total of £78.12.",
      "assertions": [{"kind": "region_arithmetic", "where": "/claims/CL-\\d+$", "expression": "total <= 50",
                      "operands": {"total": "claim_total"},
                      "guard": {"region": "claim_approver", "contains": "manager"},
                      "describes": "a claim approved by a manager is within the manager's £50 limit"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 11,
      "trigger_trace": [
        {"type": "CLICK", "id": "new-claim"},
        {"type": "TYPE", "id": "description-1", "params": {"category": "valid_typical"}},
        {"type": "TYPE", "id": "amount-1", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "add-line"},
        {"type": "TYPE", "id": "description-2", "params": {"category": "valid_typical"}},
        {"type": "SELECT", "id": "currency-2", "params": {"option": "EUR"}},
        {"type": "TYPE", "id": "amount-2", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "lodge-claim"},
        {"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
        {"type": "CLICK", "id": "switch-role"},
        {"type": "CLICK", "id": "open-CL-104"},
        {"type": "CLICK", "id": "approve-claim"}],
      "patch": {"file": "src/claims.js",
                "find": "const value = claimTotalPence(claim.lines, cfg.rates);",
                "replace": "const value = currencySubtotal(claim.lines, \"GBP\");"}
    }
  ],
  "benign_traces": [
    [{"type": "CLICK", "id": "new-claim"},
     {"type": "TYPE", "id": "description-1", "params": {"category": "valid_typical"}},
     {"type": "TYPE", "id": "amount-1", "params": {"category": "valid_typical"}},
     {"type": "CLICK", "id": "lodge-claim"},
     {"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
     {"type": "CLICK", "id": "switch-role"},
     {"type": "CLICK", "id": "open-CL-104"},
     {"type": "CLICK", "id": "approve-claim"}],
    [{"type": "SELECT", "id": "viewing-as", "params": {"option": "ben"}},
     {"type": "CLICK", "id": "switch-role"},
     {"type": "CLICK", "id": "open-CL-103"},
     {"type": "CLICK", "id": "approve-claim"},
     {"type": "CLICK", "id": "escalate"},
     {"type": "SELECT", "id": "viewing-as", "params": {"option": "finance"}},
     {"type": "CLICK", "id": "switch-role"},
     {"type": "CLICK", "id": "open-CL-103"},
     {"type": "CLICK", "id": "approve-claim"}],
    [{"type": "CLICK", "id": "new-claim"},
     {"type": "SELECT", "id": "currency-1", "params": {"option": "USD"}},
     {"type": "TYPE", "id": "description-1", "params": {"category": "valid_typical"}},
     {"type": "TYPE", "id": "amount-1", "params": {"category": "valid_typical"}},
     {"type": "CLICK", "id": "add-line"},
     {"type": "SELECT", "id": "currency-2", "params": {"option": "EUR"}},
     {"type": "TYPE", "id": "description-2", "params": {"category": "valid_typical"}},
     {"type": "TYPE", "id": "amount-2", "params": {"category": "valid_typical"}},
     {"type": "CLICK", "id": "remove-line-1"},
     {"type": "CLICK", "id": "save-draft"},
     {"type": "CLICK", "id": "edit-claim"}]
  ]
}
