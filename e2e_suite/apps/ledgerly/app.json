        {"type": "CLICK", "id": "new-merchant"},
        {"type": "TYPE", "id": "merchant-name-field", "params": {"category": "valid_typical"}},
        {"type": "TYPE", "id": "merchant-city-field", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "save-merchant"}
