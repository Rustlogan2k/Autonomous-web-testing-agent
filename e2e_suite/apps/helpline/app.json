{
  "app_id": "helpline",
  "name": "Helpline",
  "domain": "customer support ticketing (broadband provider's care desk)",
  "user_goal": "Work the support queue as agent Sam: filter it, answer customers, record phone replies, move tickets through their statuses, hand tickets to the on-call colleague, and merge duplicates.",
  "architecture": "server-rendered+html-fragments",
  "stack": "python-stdlib+sqlite",
  "persistence": "one sqlite database file per session, copied from a seeded template; every page and fragment rendered from it",
  "entry": "/",
  "start": ["python", "src/server.py"],
  "dockerfile": true,
  "workflow_graph": {
    "kind": ["state-machine", "hub-and-spoke", "modal-heavy", "branching"],
    "nodes": ["queue", "queue/filtered", "ticket/conversation", "ticket/details", "ticket/history",
              "ticket/merge-dialog", "ticket/linked"],
    "edges": [["queue", "queue/filtered"], ["queue/filtered", "queue/filtered"], ["queue", "queue"],
              ["queue", "ticket/conversation"], ["queue/filtered", "ticket/conversation"],
              ["ticket/conversation", "ticket/details"], ["ticket/details", "ticket/history"],
              ["ticket/history", "ticket/conversation"], ["ticket/conversation", "ticket/conversation"],
              ["ticket/conversation", "ticket/merge-dialog"], ["ticket/merge-dialog", "ticket/conversation"],
              ["ticket/conversation", "ticket/linked"], ["ticket/linked", "ticket/conversation"],
              ["ticket/conversation", "queue"], ["ticket/conversation", "queue/filtered"]],
    "status_machine": {
      "states": ["new", "triage", "in_progress", "waiting", "resolved", "closed"],
      "transitions": [["new", "triage", "Start triage"], ["triage", "in_progress", "Start work"],
                      ["waiting", "in_progress", "Start work"],
                      ["new|triage|in_progress", "waiting", "Send reply"],
                      ["waiting|resolved", "in_progress", "Log customer reply"],
                      ["new|triage|in_progress|waiting", "resolved", "Resolve (agent has the last word)"],
                      ["resolved", "closed", "Close"], ["new|triage|in_progress|waiting", "closed", "merged into another ticket"]]
    }
  },
  "features": ["server-rendered", "fragment-update", "tabs", "modal", "table", "filter", "server-state",
               "enable-disable", "conditional-section", "cross-page-state"],
  "vocabulary": {"progress_keys": ["act.send_reply", "act.resolve", "act.close", "act.merge_confirm", "act.apply",
                                   "act.log_customer", "act.start_triage", "act.start_work", "act.handoff",
                                   "act.handoff_to"]},
  "regions": {
    "queue_rows": "#queue-rows",
    "queue_flash": "#queue-flash",
    "ticket_status": "#ticket-status",
    "latest_role": "#latest-role",
    "ticket_assignee": "#ticket-assignee",
    "linked_tickets": "#linked-tickets",
    "ticket_flash": "#ticket-flash",
    "conversation": "#conversation",
    "history_list": "#history-list",
    "customer_details": "#customer-details",
    "count_new": "#count-new",
    "count_triage": "#count-triage",
    "count_in_progress": "#count-in-progress",
    "count_waiting": "#count-waiting",
    "count_resolved": "#count-resolved",
    "count_closed": "#count-closed"
  },
  "workflows": [
    {"name": "answer a new ticket and resolve it",
     "trace": [{"type": "CLICK", "id": "open-101"},
               {"type": "TYPE", "id": "reply-body", "params": {"category": "valid_typical"}},
               {"type": "CLICK", "id": "send-reply"}, {"type": "CLICK", "id": "resolve"}],
     "expect": [{"region": "conversation", "contains": "comment used for functional testing"},
                {"region": "count_resolved", "contains": "2"}, {"region": "count_new", "contains": "2"}]},
    {"name": "hand a ticket to Kai from its page, then check the unassigned list",
     "trace": [{"type": "CLICK", "id": "open-102"}, {"type": "CLICK", "id": "handoff"},
               {"type": "CLICK", "id": "nav-unassigned"}],
     "expect": [{"region": "queue_rows", "absent": "No internet since the storm"},
                {"region": "queue_rows", "contains": "Router keeps dropping Wi-Fi"}]},
    {"name": "merge a duplicate billing ticket",
     "trace": [{"type": "CLICK", "id": "open-105"}, {"type": "CLICK", "id": "open-merge"},
               {"type": "SELECT", "id": "merge-source", "params": {"option": "106"}},
               {"type": "CLICK", "id": "merge-confirm"}],
     "expect": [{"region": "linked_tickets", "contains": "106"}, {"region": "count_closed", "contains": "2"},
                {"region": "count_new", "contains": "2"}]},
    {"name": "show only unassigned tickets",
     "trace": [{"type": "SELECT", "id": "filter-assignee", "params": {"option": "none"}},
               {"type": "CLICK", "id": "apply-filters"}],
     "expect": [{"region": "queue_rows", "contains": "Refund for the double charge"},
                {"region": "queue_rows", "absent": "Charged twice in May"}],
     "commits": false},
    {"name": "log a phone reply on a ticket waiting for the customer",
     "trace": [{"type": "CLICK", "id": "open-107"},
               {"type": "TYPE", "id": "customer-body", "params": {"category": "valid_typical"}},
               {"type": "CLICK", "id": "log-customer-reply"}],
     "expect": [{"region": "conversation", "contains": "comment used for functional testing"},
                {"region": "count_waiting", "contains": "0"}, {"region": "count_in_progress", "contains": "3"}]},
    {"name": "resolve and close an answered ticket",
     "trace": [{"type": "CLICK", "id": "open-107"}, {"type": "CLICK", "id": "resolve"},
               {"type": "CLICK", "id": "close-ticket"}],
     "expect": [{"region": "count_closed", "contains": "2"}, {"region": "count_waiting", "contains": "0"},
                {"region": "count_resolved", "contains": "1"}]},
    {"name": "hand a ticket to Kai from the queue",
     "trace": [{"type": "CLICK", "id": "handoff-103"}],
     "expect": [{"region": "queue_rows", "contains": "Kai"}]},
    {"name": "triage a new ticket and start work on it",
     "trace": [{"type": "CLICK", "id": "open-103"}, {"type": "CLICK", "id": "start-triage"},
               {"type": "CLICK", "id": "start-work"}],
     "expect": [{"region": "count_new", "contains": "2"}, {"region": "count_in_progress", "contains": "3"}]},
    {"name": "read a resolved ticket's history",
     "trace": [{"type": "SELECT", "id": "filter-status", "params": {"option": "all"}},
               {"type": "CLICK", "id": "apply-filters"}, {"type": "CLICK", "id": "open-108"},
               {"type": "CLICK", "id": "tab-history"}],
     "expect": [{"region": "history_list", "contains": "2026-06-04 09:05"}],
     "commits": false}
  ],
  "state_dependent": [
    {"name": "Resolve changes a ticket only once the agent has replied after the customer",
     "useless": {"trace": [{"type": "CLICK", "id": "open-101"}],
                 "action": {"type": "CLICK", "id": "resolve"}},
     "useful": {"trace": [{"type": "CLICK", "id": "open-101"},
                          {"type": "TYPE", "id": "reply-body", "params": {"category": "valid_typical"}},
                          {"type": "CLICK", "id": "send-reply"}],
                "action": {"type": "CLICK", "id": "resolve"}}},
    {"name": "Close changes a ticket only once it is resolved",
     "useless": {"trace": [{"type": "CLICK", "id": "open-101"}],
                 "action": {"type": "CLICK", "id": "close-ticket"}},
     "useful": {"trace": [{"type": "CLICK", "id": "open-101"},
                          {"type": "TYPE", "id": "reply-body", "params": {"category": "valid_typical"}},
                          {"type": "CLICK", "id": "send-reply"}, {"type": "CLICK", "id": "resolve"}],
                "action": {"type": "CLICK", "id": "close-ticket"}}}
  ],
  "decoys": [
    {"name": "Mark done on the on-call notification", "trace": [],
     "decoy": {"type": "CLICK", "id": "notice-done"}},
    {"name": "Refresh queue", "trace": [{"type": "SELECT", "id": "filter-status", "params": {"option": "new"}},
                                        {"type": "CLICK", "id": "apply-filters"}],
     "decoy": {"type": "CLICK", "id": "refresh-queue"}}
  ],
  "faults": [
    {
      "fault_id": "HELP-1",
      "fault_class": "broken_transition",
      "subtype": "state-transition",
      "oracle": "existing",
      "description": "Logging a reply the customer gave by phone reopens a ticket that was waiting on the customer, but not one that was resolved: the resolved ticket stays Resolved with the customer's unanswered message as its latest entry.",
      "trigger_condition": "Answer a ticket, resolve it, then log a customer reply on it (or log a customer reply on an already resolved ticket).",
      "expected_behaviour": "A ticket is never Resolved while the customer has the last word: resolving needs an agent reply last, and a customer reply on a resolved ticket reopens it to In progress.",
      "observable_violation": "The ticket's status reads Resolved while its latest entry is from the Customer.",
      "assertions": [
        {"kind": "text_absent", "where": "/tickets/\\d+", "region": "ticket_status", "expected": "Resolved",
         "describes": "a ticket whose customer has the last word is not shown as resolved"},
        {"kind": "text_absent", "where": "/tickets/\\d+", "region": "latest_role", "expected": "Customer",
         "describes": "(conjunct) the ticket's latest conversation entry is the customer's"}
      ],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 3,
      "trigger_trace": [
        {"type": "CLICK", "id": "open-101"},
        {"type": "TYPE", "id": "reply-body", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "send-reply"},
        {"type": "CLICK", "id": "resolve"},
        {"type": "TYPE", "id": "customer-body", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "log-customer-reply"}
      ],
      "patch": {
        "file": "src/desk.py",
        "find": "    if row[\"status\"] in (\"waiting\", \"resolved\"):  # the customer answered: back to work\n",
        "replace": "    if row[\"status\"] == \"waiting\":  # the customer answered: back to work\n"
      }
    },
    {
      "fault_id": "HELP-2",
      "fault_class": "broken_transition",
      "subtype": "workflow-completion",
      "oracle": "existing",
      "description": "Merging ticket B into ticket A closes B as merged into A and links B to A, but writes only B's side of the link, so A's 'Linked tickets' never lists the ticket that was merged into it.",
      "trigger_condition": "Open a ticket, open 'Merge…', choose another open ticket and confirm the merge.",
      "expected_behaviour": "Right after a merge, the receiving ticket lists the merged ticket among its linked tickets.",
      "observable_violation": "The page says 'Merged #106 into this ticket' while its Linked tickets list does not contain #106.",
      "assertions": [
        {"kind": "echoes_input", "where": "/tickets/\\d+", "region": "linked_tickets", "input_field": "merge_source",
         "describes": "the ticket chosen in the merge dialog appears in this ticket's linked tickets"},
        {"kind": "text_absent", "where": "/tickets/\\d+", "region": "ticket_flash", "expected": "#",
         "describes": "(scope) evaluated on the response to a merge, whose one-time banner names the merged ticket"}
      ],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 4,
      "trigger_trace": [
        {"type": "CLICK", "id": "open-105"},
        {"type": "CLICK", "id": "open-merge"},
        {"type": "SELECT", "id": "merge-source", "params": {"option": "106"}},
        {"type": "CLICK", "id": "merge-confirm"}
      ],
      "patch": {
        "file": "src/desk.py",
        "find": "for owner, other in ((target_id, source[\"id\"]), (source[\"id\"], target_id)):",
        "replace": "for owner, other in ((source[\"id\"], target_id),):"
      }
    },
    {
      "fault_id": "HELP-3",
      "fault_class": "state_corruption",
      "subtype": "stale-state",
      "oracle": "existing",
      "description": "The queue's assignee filters read a denormalised assignee index. The queue's row 'Hand off' re-indexes only tickets that already had an assignee, so a ticket handed off from Unassigned keeps its stale index entry and stays listed under Unassigned, its row showing Kai. The ticket page's hand-off re-indexes correctly.",
      "trigger_condition": "Filter the queue to unassigned tickets and hand one off from its row.",
      "expected_behaviour": "The queue filtered to unassigned tickets lists only tickets nobody owns.",
      "observable_violation": "The Unassigned view lists a ticket whose assignee column says Kai.",
      "assertions": [
        {"kind": "text_absent", "where": "/queue\\?.*assignee=none", "region": "queue_rows", "expected": "Kai",
         "describes": "the unassigned view lists no ticket assigned to Kai"}
      ],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 3,
      "trigger_trace": [
        {"type": "SELECT", "id": "filter-assignee", "params": {"option": "none"}},
        {"type": "CLICK", "id": "apply-filters"},
        {"type": "CLICK", "id": "handoff-102"}
      ],
      "patch": {
        "file": "src/desk.py",
        "find": "    refresh_assignee_index(conn, [row[\"id\"] for row in tickets])\n",
        "replace": "    refresh_assignee_index(conn, [row[\"id\"] for row in tickets if row[\"assignee\"]])\n"
      }
    }
  ],
  "benign_traces": [
    [{"type": "CLICK", "id": "open-102"}, {"type": "CLICK", "id": "handoff"}, {"type": "CLICK", "id": "nav-unassigned"}],
    [{"type": "CLICK", "id": "open-101"}, {"type": "TYPE", "id": "reply-body", "params": {"category": "valid_typical"}},
     {"type": "CLICK", "id": "send-reply"}, {"type": "CLICK", "id": "resolve"}, {"type": "CLICK", "id": "close-ticket"}],
    [{"type": "SELECT", "id": "filter-status", "params": {"option": "new"}}, {"type": "CLICK", "id": "apply-filters"},
     {"type": "CLICK", "id": "open-103"}, {"type": "CLICK", "id": "tab-details"}, {"type": "CLICK", "id": "tab-history"},
     {"type": "CLICK", "id": "start-triage"}],
    [{"type": "CLICK", "id": "open-107"}, {"type": "TYPE", "id": "customer-body", "params": {"category": "valid_typical"}},
     {"type": "CLICK", "id": "log-customer-reply"}, {"type": "CLICK", "id": "nav-queue"},
     {"type": "SELECT", "id": "filter-assignee", "params": {"option": "noor"}}, {"type": "CLICK", "id": "apply-filters"},
     {"type": "CLICK", "id": "handoff-104"},
     {"type": "SELECT", "id": "filter-assignee", "params": {"option": "none"}}, {"type": "CLICK", "id": "apply-filters"}]
  ]
}
