{
  "app_id": "helpline",
  "name": "Helpline",
  "domain": "customer support ticketing (broadband provider's care desk)",
  "user_goal": "Sign in as agent Sam and work the support queue: filter it, answer customers (with saved replies), record phone replies, move tickets through their statuses, hand tickets to the on-call colleague, merge duplicates, open tickets for customers, and keep the customer directory and saved replies.",
  "architecture": "server-rendered+html-fragments",
  "stack": "python-stdlib+pymongo+mongodb",
  "persistence": "mongodb database per signed-in session, created from the seed with validators; every page and fragment rendered from it",
  "entry": "/",
  "start": [
    "python",
    "src/server.py"
  ],
  "dockerfile": true,
  "database": {
    "engine": "mongodb",
    "isolation": "database-per-session",
    "schema": "src/schema.py",
    "entities": [
      "agents",
      "customers",
      "tickets",
      "queue_index",
      "sla_policies",
      "replies"
    ],
    "auxiliary": [
      "counters"
    ],
    "references": [
      {
        "from": "tickets.customer_id",
        "to": "customers._id"
      },
      {
        "from": "tickets.assignee_id",
        "to": "agents._id"
      },
      {
        "from": "tickets.linked[]",
        "to": "tickets._id"
      },
      {
        "from": "tickets.merged_into",
        "to": "tickets._id"
      },
      {
        "from": "tickets.entries[].author_id",
        "to": "agents._id"
      },
      {
        "from": "queue_index._id",
        "to": "tickets._id"
      },
      {
        "from": "tickets.priority",
        "to": "sla_policies._id"
      },
      {
        "from": "replies.author_id",
        "to": "agents._id"
      }
    ],
    "probes": [
      {
        "name": "a ticket that belongs to no customer",
        "kind": "required",
        "collection": "tickets",
        "insert": {
          "_id": 990,
          "subject": "Orphan",
          "channel": "email",
          "priority": "low",
          "status": "new",
          "assignee_id": null,
          "merged_into": null,
          "linked": [],
          "tags": [],
          "opened": "2026-06-10 09:00",
          "entries": [
            {
              "role": "system",
              "at": "2026-06-10 09:00",
              "event": "acknowledged"
            }
          ],
          "history": []
        }
      },
      {
        "name": "a ticket in a status the desk does not have",
        "kind": "enum",
        "collection": "tickets",
        "update": {
          "filter": {
            "_id": 101
          },
          "update": {
            "$set": {
              "status": "escalated"
            }
          }
        }
      },
      {
        "name": "a customer on a plan that is not sold",
        "kind": "enum",
        "collection": "customers",
        "update": {
          "filter": {
            "_id": "c1"
          },
          "update": {
            "$set": {
              "plan.name": "Satellite"
            }
          }
        }
      },
      {
        "name": "a second agent with Sam's username",
        "kind": "duplicate",
        "collection": "agents",
        "insert": {
          "_id": "sam2",
          "username": "sam.lewis",
          "name": "Sam Lewis",
          "roles": [
            "agent"
          ],
          "on_call": false,
          "pw": {
            "salt": "00",
            "hash": "00",
            "iter": 20000
          }
        }
      },
      {
        "name": "a second customer with Priya Shah's email",
        "kind": "duplicate",
        "collection": "customers",
        "update": {
          "filter": {
            "_id": "c2"
          },
          "update": {
            "$set": {
              "email": "priya.shah@example.net"
            }
          }
        }
      }
    ],
    "absent_constraints": []
  },
  "login": {
    "path": "/login",
    "protected": [
      "/",
      "/queue",
      "/tickets/101",
      "/customers",
      "/replies",
      "/tickets/new"
    ],
    "public": [
      "/help/sign-in"
    ],
    "users": [
      {
        "username": "sam.lewis",
        "name": "Sam Lewis",
        "roles": [
          "agent"
        ],
        "macro": true
      },
      {
        "username": "kai.moreno",
        "name": "Kai Moreno",
        "roles": [
          "agent"
        ]
      },
      {
        "username": "noor.haddad",
        "name": "Noor Haddad",
        "roles": [
          "agent"
        ]
      },
      {
        "username": "morgan.blake",
        "name": "Morgan Blake",
        "roles": [
          "agent",
          "lead"
        ]
      }
    ],
    "password_value": "Helpline-desk-26",
    "steps": [
      {
        "type": "TYPE",
        "id": "login-username",
        "params": {
          "value": "sam.lewis"
        }
      },
      {
        "type": "TYPE",
        "id": "login-password",
        "params": {
          "value": "Helpline-desk-26"
        }
      },
      {
        "type": "CLICK",
        "id": "login-submit"
      }
    ],
    "form": {
      "action": "/login",
      "username_field": "username",
      "password_field": "password"
    },
    "signed_in_region": "signed_in_as",
    "error_region": "login_error",
    "sign_out": [
      {
        "type": "CLICK",
        "id": "nav-account"
      },
      {
        "type": "CLICK",
        "id": "sign-out"
      }
    ],
    "restricted": [
      {
        "user": "kai.moreno",
        "path": "/reports",
        "region": "access_notice"
      }
    ]
  },
  "breadth": {
    "views": [
      {
        "name": "sign-in page",
        "path": "/login",
        "as": null
      },
      {
        "name": "sign-in help",
        "path": "/help/sign-in",
        "as": null
      },
      {
        "name": "queue",
        "path": "/queue"
      },
      {
        "name": "ticket",
        "path": "/tickets/101"
      },
      {
        "name": "new ticket: customer",
        "path": "/tickets/new"
      },
      {
        "name": "new ticket: details",
        "workflow": "open a ticket for a customer with the wizard",
        "where": "/tickets/new/details\\?"
      },
      {
        "name": "new ticket: review",
        "workflow": "open a ticket for a customer with the wizard",
        "where": "/tickets/new/review\\?"
      },
      {
        "name": "customer directory",
        "path": "/customers"
      },
      {
        "name": "customer profile",
        "path": "/customers/c1"
      },
      {
        "name": "new customer form",
        "path": "/customers/new"
      },
      {
        "name": "edit customer form",
        "path": "/customers/c1/edit"
      },
      {
        "name": "saved replies",
        "path": "/replies"
      },
      {
        "name": "team",
        "path": "/team"
      },
      {
        "name": "SLA report",
        "path": "/reports",
        "as": "morgan.blake"
      }
    ],
    "entities": {
      "customer": {
        "create": "add a customer, then delete the record",
        "read": "update a customer's phone number",
        "update": "update a customer's phone number",
        "delete": "add a customer, then delete the record"
      },
      "ticket": {
        "create": "open a ticket for a customer with the wizard",
        "read": "reload a ticket on its history tab",
        "update": "answer a new ticket and resolve it",
        "delete": "delete a ticket opened by mistake"
      },
      "saved reply": {
        "create": "add a saved reply",
        "read": "move a saved reply to the top",
        "update": "rename a saved reply in place",
        "delete": "delete a saved reply after confirming"
      }
    },
    "patterns": {
      "pagination": "browse the customer directory to its last page",
      "sort-filter": "list customers with the fastest plans first",
      "search": "search the directory for a customer nobody has",
      "modal": "merge a duplicate billing ticket",
      "tabs": "reload a ticket on its history tab",
      "inline-edit": "rename a saved reply in place",
      "wizard": "open a ticket for a customer with the wizard",
      "reorder": "move a saved reply to the top"
    }
  },
