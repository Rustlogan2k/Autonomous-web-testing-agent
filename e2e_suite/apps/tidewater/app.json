            "option": "payee:mum"
          }
        },
        {
          "type": "CLICK",
          "id": "to-amount"
        },
        {
          "type": "TYPE",
          "id": "amount",
          "params": {
            "category": "valid_typical"
          }
        },
        {
          "type": "SELECT",
          "id": "when",
          "params": {
            "option": "next-friday"
          }
        },
        {
          "type": "CLICK",
          "id": "review-transfer"
        },
        {
          "type": "CLICK",
          "id": "authorise"
        }
      ],
      "expect": [
        {
          "region": "scheduled_date",
          "contains": "Fri 12 Jun 2026"
        }
      ]
    },
    {
      "name": "schedule then cancel from the dashboard",
      "trace": [
        {
          "type": "CLICK",
          "id": "nav-move"
        },
        {
          "type": "CLICK",
          "id": "to-amount"
        },
        {
          "type": "TYPE",
          "id": "amount",
          "params": {
            "category": "valid_typical"
          }
        },
        {
          "type": "SELECT",
          "id": "when",
          "params": {
            "option": "month-end"
          }
        },
        {
          "type": "CLICK",
          "id": "review-transfer"
        },
        {
          "type": "CLICK",
          "id": "authorise"
        },
        {
          "type": "CLICK",
          "id": "nav-accounts"
        },
        {
          "type": "CLICK",
          "id": "cancel-1"
        }
      ],
      "expect": [
        {
          "region": "scheduled_table",
          "absent": "Tue 30 Jun 2026"
        },
        {
          "region": "balance_everyday",
          "contains": "540.00"
        }
      ]
    },
    {
      "name": "add a payee through the modal",
      "trace": [
        {
          "type": "CLICK",
          "id": "nav-payees"
        },
        {
          "type": "CLICK",
          "id": "add-payee"
        },
        {
          "type": "TYPE",
          "id": "new-payee-name",
          "params": {
            "category": "valid_typical"
          }
        },
        {
          "type": "SELECT",
          "id": "new-payee-bank",
          "params": {
            "option": "Northgate"
          }
        },
        {
          "type": "TYPE",
          "id": "new-payee-number",
          "params": {
            "category": "valid_typical"
          }
        },
        {
          "type": "CLICK",
          "id": "check-payee"
        },
        {
          "type": "CLICK",
          "id": "confirm-payee"
        }
      ],
      "expect": [
        {
          "region": "payee_table",
          "contains": "Test User Input"
        }
      ]
    },
    {
      "name": "rename a payee, then start a transfer",
      "trace": [
        {
          "type": "CLICK",
          "id": "nav-payees"
        },
        {
          "type": "CLICK",
          "id": "edit-mum"
        },
        {
          "type": "TYPE",
          "id": "nickname",
          "params": {
            "category": "valid_typical"
          }
        },
        {
          "type": "CLICK",
          "id": "nav-move"
        }
      ],
      "expect": [
        {
          "region": "to_options",
          "contains": "Test User Input"
        }
      ]
    },
    {
      "name": "filter statements to the Saver account",
      "trace": [
        {
          "type": "CLICK",
          "id": "nav-statements"
        },
        {
          "type": "SELECT",
          "id": "stmt-account",
          "params": {
            "option": "saver"
          }
        },
        {
          "type": "CLICK",
          "id": "apply-statement-filter"
        }
      ],
      "expect": [
        {
          "region": "statement_count",
          "contains": "1 "
        },
        {
          "region": "statement_table",
          "contains": "From Everyday"
        },
        {
          "region": "statement_table",
          "absent": "Salary"
        }
      ],
      "commits": false
    }
  ],
  "state_dependent": [
    {
      "name": "Authorise commits a reviewed transfer once; the same button on the same reviewed transfer after it was sent does nothing",
      "useless": {
        "trace": [
          {
            "type": "CLICK",
            "id": "nav-move"
          },
          {
            "type": "CLICK",
            "id": "to-amount"
          },
          {
            "type": "TYPE",
            "id": "amount",
            "params": {
              "category": "valid_typical"
            }
