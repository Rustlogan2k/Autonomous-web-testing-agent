{
  "app_id": "tidewater",
  "name": "Tidewater",
  "domain": "personal banking",
  "user_goal": "Move money between accounts and to payees, now or on a schedule; manage payees; read statements.",
  "architecture": "spa-hash-router+json-api",
  "stack": "python-stdlib+sqlite",
  "persistence": "sqlite rows partitioned by session; client keeps wizard state and a payee cache in memory",
  "entry": "/",
  "start": [
    "python",
    "src/server.py"
  ],
  "dockerfile": true,
  "workflow_graph": {
    "kind": [
      "hub-and-spoke",
      "linear-wizard",
      "modal-heavy",
      "revisit"
    ],
    "nodes": [
      "dashboard",
      "offers",
      "move/accounts",
      "move/amount",
      "move/review",
      "move/done",
      "move/scheduled",
      "payees",
      "payee-modal:form",
      "payee-modal:confirm",
      "payee/edit",
      "statements"
    ],
    "edges": [
