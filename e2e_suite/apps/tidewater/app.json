  "regions": {
    "review_after": "#review-after",
    "review_from": "#review-from",
    "to_options": "#to-target",
    "done_summary": "#done-summary",
    "scheduled_date": "#scheduled-date",
    "payee_table": "#payee-table",
    "statement_count": "#statement-count",
    "statement_table": "#statement-table",
    "scheduled_table": "#scheduled-table",
    "balance_everyday": "#balance-everyday"
  },
  "workflows": [
    {
      "name": "pay the landlord now",
      "trace": [
        {
          "type": "CLICK",
          "id": "nav-move"
        },
        {
          "type": "CLICK",
          "id": "to-amount"
        },
        {
          "type": "TYPE",
          "id": "amount",
          "params": {
            "category": "valid_typical"
          }
        },
        {
          "type": "TYPE",
          "id": "reference",
          "params": {
            "category": "valid_typical"
          }
        },
        {
          "type": "CLICK",
          "id": "review-transfer"
        },
        {
          "type": "CLICK",
          "id": "authorise"
        },
        {
          "type": "CLICK",
