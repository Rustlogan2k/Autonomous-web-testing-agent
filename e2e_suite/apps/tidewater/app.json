  "faults": [
    {
      "fault_id": "TIDE-1",
      "fault_class": "constraint_bypass",
      "subtype": "missing-validation",
      "oracle": "existing",
      "description": "Funds are checked against a snapshot taken when the source account is first chosen. When the customer goes back and switches to a different source account, the snapshot is not refreshed, so a transfer larger than the new account holds is quoted and can be authorised.",
      "trigger_condition": "Choose the accounts, enter an amount the first account can cover, go back, switch the source to the Saver (which holds less), and review.",
      "expected_behaviour": "A transfer is never quoted for more than the source account holds: the review never shows a negative balance afterwards.",
      "observable_violation": "The review shows a negative 'Available after transfer' for the Saver.",
      "assertions": [
        {
          "kind": "text_absent",
          "where": "#/move/review$",
          "region": "review_after",
          "expected": "-£",
          "describes": "the review must never quote a transfer that leaves the source account below zero"
        }
      ],
      "reproduction": {
        "replays": 2,
        "must_all_reproduce": true
      },
      "observation_horizon": 0,
      "shortest_path": 7,
      "trigger_trace": [
        {
          "type": "CLICK",
          "id": "nav-move"
        },
        {
          "type": "CLICK",
          "id": "to-amount"
        },
        {
          "type": "TYPE",
          "id": "amount",
          "params": {
            "category": "valid_typical"
          }
        },
        {
          "type": "CLICK",
          "id": "change-accounts"
        },
        {
          "type": "SELECT",
          "id": "from-account",
          "params": {
            "option": "saver"
          }
        },
        {
          "type": "CLICK",
          "id": "to-amount"
        },
        {
          "type": "CLICK",
          "id": "review-transfer"
        }
      ],
      "patch": {
        "file": "src/server.py",
        "find": "            if source != draft[\"source_id\"]:\n                snapshot = available(db, source)",
        "replace": "            if draft[\"available_snapshot_pence\"] is None:\n                snapshot = available(db, source)"
      }
    },
    {
      "fault_id": "TIDE-2",
      "fault_class": "broken_transition",
      "subtype": "state-transition",
      "oracle": "existing",
      "description": "Authorising compares the transfer's timing against a constant left over from an earlier version of the API, so no future-dated transfer is recognised as scheduled: every one is executed at once.",
      "trigger_condition": "Set up a transfer for next Friday (or the end of the month), review it, and authorise it.",
      "expected_behaviour": "A transfer dated in the future is scheduled, not sent: the customer lands on the 'scheduled' confirmation and no money moves today.",
      "observable_violation": "The customer lands on the 'Money sent' confirmation for a transfer they asked to send next Friday.",
      "assertions": [
        {
          "kind": "reached_with_invalid_input",
          "where": "#/move/done$",
          "input_field": "when",
          "expected": "^(next-friday|month-end)$",
          "describes": "the 'sent now' confirmation is only for transfers the customer asked to send today"
        }
      ],
      "reproduction": {
        "replays": 2,
        "must_all_reproduce": true
      },
      "observation_horizon": 0,
      "shortest_path": 6,
      "trigger_trace": [
        {
          "type": "CLICK",
          "id": "nav-move"
        },
        {
          "type": "CLICK",
          "id": "to-amount"
        },
        {
          "type": "TYPE",
          "id": "amount",
          "params": {
            "category": "valid_typical"
          }
        },
        {
          "type": "SELECT",
          "id": "when",
          "params": {
            "option": "next-friday"
          }
        },
        {
          "type": "CLICK",
          "id": "review-transfer"
        },
        {
          "type": "CLICK",
          "id": "authorise"
        }
      ],
      "patch": {
        "file": "src/server.py",
        "find": "        if quote[\"run_when\"] in SCHEDULE_OPTIONS:",
        "replace": "        if quote[\"run_when\"] == \"scheduled\":"
      }
    },
    {
      "fault_id": "TIDE-3",
      "fault_class": "state_corruption",
      "subtype": "stale-state",
      "oracle": "existing",
      "description": "Renaming a payee saves to the server, but the client's cached payee list that the transfer form reads is not invalidated, so the form keeps offering the old name for the rest of the session.",
      "trigger_condition": "Open the transfer form (which caches payees), rename a payee, then open the transfer form again.",
      "expected_behaviour": "The transfer form always lists payees under their current names.",
      "observable_violation": "The 'To' list still shows the payee's old name after the rename was saved.",
      "assertions": [
        {
          "kind": "echoes_input",
          "where": "#/move$",
          "region": "to_options",
          "input_field": "nickname",
          "describes": "a payee's saved nickname appears in the transfer form's payee list"
        }
      ],
      "reproduction": {
        "replays": 2,
        "must_all_reproduce": true
      },
      "observation_horizon": 1,
      "shortest_path": 5,
      "trigger_trace": [
        {
          "type": "CLICK",
          "id": "nav-move"
        },
        {
          "type": "CLICK",
          "id": "nav-payees"
        },
        {
          "type": "CLICK",
          "id": "edit-mum"
        },
        {
          "type": "TYPE",
          "id": "nickname",
          "params": {
            "category": "valid_typical"
          }
        },
        {
          "type": "CLICK",
          "id": "nav-move"
        }
      ],
      "patch": {
        "file": "src/static/app.js",
        "find": "      payeeCache = null; // the transfer form lists payees by name\n",
        "replace": ""
      }
    }
  ],
