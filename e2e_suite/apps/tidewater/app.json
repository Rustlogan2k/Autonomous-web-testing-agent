    "path": "/login",
    "protected": [
      "/",
      "/#/move",
      "/#/payees",
      "/#/statements"
    ],
    "public": [
      "/help/password"
    ],
    "users": [
      {
        "username": "alex.carter",
        "name": "Alex Carter",
        "roles": [
          "holder"
        ],
        "macro": true
      },
      {
        "username": "jamie.carter",
        "name": "Jamie Carter",
        "roles": [
          "viewer"
        ]
      }
    ],
    "password_value": "Tidewater-quay-26",
