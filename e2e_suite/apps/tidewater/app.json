        "move/amount"
      ],
      [
        "move/amount",
        "move/accounts"
      ],
      [
        "move/amount",
        "move/review"
      ],
      [
        "move/review",
        "move/amount"
      ],
      [
        "move/review",
        "move/done"
      ],
      [
        "move/review",
        "move/scheduled"
      ],
      [
        "payees",
        "payee-modal:form"
      ],
      [
        "payee-modal:form",
        "payee-modal:confirm"
      ],
      [
        "payee-modal:confirm",
        "payee-modal:form"
      ],
      [
        "payee-modal:confirm",
        "payees"
      ],
      [
        "payees",
        "payee/edit"
      ],
      [
        "payee/edit",
        "payees"
      ],
      [
        "dashboard",
        "dashboard"
      ],
      [
        "statements",
        "statements"
      ]
