        {"type": "CLICK", "id": "product-lantern"},
        {"type": "CLICK", "id": "tab-reviews"},
        {"type": "SELECT", "id": "review-stars", "params": {"option": "4"}},
        {"type": "TYPE", "id": "review-text", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "post-review"}
      ],
      "expect": [
