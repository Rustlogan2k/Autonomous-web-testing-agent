    },
    {
      "name": "page through everything the shop sells",
      "trace": [
        {"type": "CLICK", "id": "cat-all"},
        {"type": "CLICK", "id": "results-next"}
      ],
      "expect": [
        {"region": "results_page", "contains": "2"},
        {"region": "results_pages", "contains": "2"},
        {"region": "results_list", "contains": "Folding stool"}
      ],
      "commits": false
    },
    {
      "name": "sort the outdoor department, dearest first",
      "trace": [
        {"type": "CLICK", "id": "cat-outdoor"},
        {"type": "SELECT", "id": "sort", "params": {"option": "price-desc"}},
        {"type": "CLICK", "id": "apply-filters"}
      ],
      "expect": [
        {"region": "result_1_price", "contains": "44.00"},
        {"region": "result_2_price", "contains": "28.00"}
      ],
      "commits": false
    },
    {
      "name": "narrow a search to one department",
      "trace": [
        {"type": "TYPE", "id": "search-q", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "search-go"},
        {"type": "SELECT", "id": "filter-category", "params": {"option": "kitchen"}},
        {"type": "CLICK", "id": "apply-filters"}
      ],
      "expect": [
        {"region": "results_list", "contains": "Bread crock"},
        {"region": "results_list", "absent": "Storm lantern"}
      ],
      "commits": false
    },
    {
      "name": "add an address to the address book",
      "trace": [
        {"type": "CLICK", "id": "nav-account"},
        {"type": "CLICK", "id": "account-addresses"},
        {"type": "CLICK", "id": "add-address"},
        {"type": "TYPE", "id": "addr-label", "params": {"category": "valid_typical"}},
        {"type": "TYPE", "id": "addr-name", "params": {"category": "valid_typical"}},
        {"type": "TYPE", "id": "addr-line1", "params": {"category": "valid_typical"}},
        {"type": "TYPE", "id": "addr-town", "params": {"category": "valid_typical"}},
        {"type": "TYPE", "id": "addr-postcode", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "save-address"}
      ],
      "expect": [
        {
          "region": "address_list",
          "contains": "Test User Input, Test User Input Test User Input"
