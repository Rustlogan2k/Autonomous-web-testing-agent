{
  "app_id": "bagstreet",
  "name": "Bagstreet",
  "domain": "e-commerce",
  "user_goal": "Find products, fill a bag, use a voucher, choose delivery or collection and place an order; keep an address book and review products; staff dispatch orders.",
  "architecture": "server-rendered-multipage+html-forms+progressive-enhancement",
  "stack": "python-stdlib+pymongo+mongodb",
  "persistence": "mongodb database per signed-in session; everything rendered from the database (post/redirect/get)",
  "entry": "/",
  "start": ["python", "src/server.py"],
  "dockerfile": true,
  "workflow_graph": {
    "kind": ["linear-wizard", "hub-and-spoke", "revisit"],
    "nodes": [
      "login",
      "forgot",
      "home",
      "results",
      "product",
      "review-editor",
      "bag",
      "delivery",
      "review",
      "confirmation",
      "orders",
      "account",
      "addresses",
      "address-form",
      "staff-orders",
      "access-notice",
      "express-info",
      "gift-info"
    ],
    "edges": [
      ["login", "home"],
      ["login", "forgot"],
      ["home", "results"],
      ["results", "results"],
      ["results", "product"],
      ["product", "bag"],
      ["product", "results"],
      ["product", "product"],
      ["product", "review-editor"],
      ["review-editor", "product"],
      ["bag", "bag"],
      ["bag", "delivery"],
      ["bag", "gift-info"],
      ["delivery", "delivery"],
      ["delivery", "review"],
      ["delivery", "bag"],
      ["review", "delivery"],
      ["review", "bag"],
      ["review", "confirmation"],
      ["confirmation", "orders"],
      ["orders", "confirmation"],
      ["home", "express-info"],
      ["home", "account"],
      ["account", "addresses"],
      ["account", "orders"],
      ["addresses", "address-form"],
      ["address-form", "addresses"],
      ["addresses", "addresses"],
      ["account", "login"],
      ["home", "staff-orders"],
      ["staff-orders", "staff-orders"],
      ["home", "access-notice"]
    ]
  },
  "features": [
    "server-rendered",
    "server-state",
    "login",
    "roles",
    "table",
    "filter",
    "sort",
    "pagination",
    "search",
    "tabs",
    "modal",
    "bulk-action",
    "conditional-section",
    "cross-page-state",
    "dynamic-validation"
  ],
  "vocabulary": {
    "progress_keys": [
      "act.add",
      "act.checkout",
      "act.review_order",
      "act.place_order",
      "act.update_bag",
      "act.apply_voucher",
      "act.save",
      "act.post_review",
      "act.remove_selected"
    ]
  },
  "regions": {
    "results_list": "#results-list",
    "bag_subtotal": "#bag-subtotal",
    "bag_discount": "#bag-discount",
    "bag_voucher": "#bag-voucher",
    "bag_total": "#bag-total",
    "notice": "#notice",
    "confirm_method": "#confirm-method",
    "confirm_address": "#confirm-address",
    "confirm_total": "#confirm-total",
    "order_history": "#order-history",
    "result_1_price": "#result-1-price",
    "result_2_price": "#result-2-price",
    "results_page": "#results-page",
    "results_pages": "#results-pages",
    "order_status": "#order-status",
    "review_list": "#review-list",
    "address_list": "#address-list",
    "staff_orders": "#staff-orders",
    "signed_in_as": "#signed-in-as",
    "login_error": "#login-error",
    "access_notice": "#access-notice"
  },
  "workflows": [
    {
      "name": "buy a lantern with standard delivery",
      "trace": [
        {"type": "CLICK", "id": "cat-lighting"},
        {"type": "CLICK", "id": "product-lantern"},
        {"type": "CLICK", "id": "add-to-bag"},
        {"type": "CLICK", "id": "go-checkout"},
        {"type": "TYPE", "id": "full-name", "params": {"category": "valid_typical"}},
        {"type": "TYPE", "id": "address", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "review-order"},
        {"type": "CLICK", "id": "place-order"}
      ],
      "expect": [
        {"region": "confirm_total", "contains": "27.95"},
        {"region": "confirm_address", "contains": "Test User Input"}
      ]
    },
    {
      "name": "use the 10% voucher on a kettle",
      "trace": [
        {"type": "CLICK", "id": "cat-kitchen"},
        {"type": "CLICK", "id": "product-kettle"},
        {"type": "CLICK", "id": "add-to-bag"},
        {"type": "SELECT", "id": "voucher", "params": {"option": "welcome10"}},
        {"type": "CLICK", "id": "apply-voucher"}
      ],
      "expect": [
        {"region": "bag_discount", "contains": "3.60"},
        {"region": "bag_total", "contains": "32.40"}
      ]
    },
    {
      "name": "collect a hammock from the shop",
      "trace": [
        {"type": "CLICK", "id": "cat-outdoor"},
        {"type": "CLICK", "id": "product-hammock"},
        {"type": "CLICK", "id": "add-to-bag"},
        {"type": "CLICK", "id": "go-checkout"},
        {"type": "SELECT", "id": "method", "params": {"option": "collect"}},
        {"type": "CLICK", "id": "review-order"},
        {"type": "CLICK", "id": "place-order"}
      ],
      "expect": [
        {"region": "confirm_address", "contains": "14 Mill Lane"},
        {"region": "confirm_total", "contains": "44.00"}
      ]
    },
    {
      "name": "search, then sort by price",
      "trace": [
        {"type": "TYPE", "id": "search-q", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "search-go"},
        {"type": "SELECT", "id": "sort", "params": {"option": "price-asc"}},
        {"type": "CLICK", "id": "apply-filters"}
      ],
      "expect": [
        {
          "region": "results_list",
          "contains": "Linen tea towel from £8.50 Solar path lights"
        }
      ],
      "commits": false
    },
    {
      "name": "choose the large lantern",
      "trace": [
        {"type": "CLICK", "id": "cat-lighting"},
        {"type": "CLICK", "id": "product-lantern"},
        {"type": "SELECT", "id": "variant", "params": {"option": "large"}},
        {"type": "CLICK", "id": "add-to-bag"}
      ],
      "expect": [
        {"region": "bag_subtotal", "contains": "32.00"}
      ]
    },
    {
      "name": "buy, then find the order in the history",
      "trace": [
        {"type": "CLICK", "id": "cat-kitchen"},
        {"type": "CLICK", "id": "product-tea-towel"},
        {"type": "CLICK", "id": "add-to-bag"},
        {"type": "CLICK", "id": "go-checkout"},
        {"type": "TYPE", "id": "full-name", "params": {"category": "valid_typical"}},
        {"type": "TYPE", "id": "address", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "review-order"},
        {"type": "CLICK", "id": "place-order"},
        {"type": "CLICK", "id": "all-orders"}
