      "trace": [
        {"type": "CLICK", "id": "nav-account"},
        {"type": "CLICK", "id": "account-addresses"}
      ],
      "expect": [
        {"region": "address_list", "contains": "3 Weavers Row, Hebden Bridge HX7 8AD"}
      ],
      "commits": false
    },
    {
