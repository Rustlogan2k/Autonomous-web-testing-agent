      "trace": [
        {"type": "CLICK", "id": "nav-account"},
        {"type": "CLICK", "id": "account-addresses"},
        {"type": "CLICK", "id": "edit-address-work"},
        {"type": "TYPE", "id": "addr-line1", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "save-address"}
      ],
      "expect": [
        {"region": "address_list", "contains": "Test User Input, Todmorden OL14 5RT"},
        {"region": "address_list", "absent": "Calder Works"}
      ]
    },
    {
      "name": "delete the work address after confirming",
      "trace": [
        {"type": "CLICK", "id": "nav-account"},
        {"type": "CLICK", "id": "account-addresses"},
        {"type": "CLICK", "id": "delete-address-work"},
        {"type": "CLICK", "id": "confirm-delete-work"}
      ],
      "expect": [
        {"region": "address_list", "absent": "Todmorden"},
        {"region": "address_list", "contains": "Hebden Bridge"}
      ]
    },
    {
      "name": "deliver to a saved address",
      "trace": [
        {"type": "CLICK", "id": "cat-lighting"},
        {"type": "CLICK", "id": "product-lantern"},
        {"type": "CLICK", "id": "add-to-bag"},
        {"type": "CLICK", "id": "go-checkout"},
        {"type": "SELECT", "id": "saved-address", "params": {"option": "work"}},
        {"type": "CLICK", "id": "review-order"},
        {"type": "CLICK", "id": "place-order"}
      ],
      "expect": [
        {"region": "confirm_address", "contains": "Unit 4, Calder Works, Todmorden OL14 5RT"},
        {"region": "confirm_total", "contains": "27.95"}
      ]
    },
    {
