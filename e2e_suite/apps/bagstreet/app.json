{
  "app_id": "bagstreet",
  "name": "Bagstreet",
  "domain": "e-commerce",
  "user_goal": "Find products, fill a bag, use a voucher, choose delivery or collection, and place an order.",
  "architecture": "server-rendered-multipage+html-forms",
  "stack": "python-stdlib+sqlite",
  "persistence": "sqlite rows partitioned by session; everything rendered from the database (post/redirect/get)",
  "entry": "/",
  "start": ["python", "src/server.py"],
  "dockerfile": true,
  "workflow_graph": {
    "kind": ["linear-wizard", "revisit"],
    "nodes": ["home", "results", "product", "bag", "delivery", "review", "confirmation", "orders",
              "express-info", "gift-info"],
    "edges": [["home", "results"], ["results", "results"], ["results", "product"], ["product", "bag"],
              ["product", "results"], ["bag", "bag"], ["bag", "delivery"], ["bag", "gift-info"],
              ["delivery", "delivery"], ["delivery", "review"], ["delivery", "bag"], ["review", "delivery"],
              ["review", "bag"], ["review", "confirmation"], ["confirmation", "orders"],
              ["orders", "confirmation"], ["home", "express-info"]]
  },
  "features": ["server-rendered", "server-state", "table", "filter", "sort", "conditional-section",
               "cross-page-state", "dynamic-validation"],
  "vocabulary": {"progress_keys": ["act.add", "act.checkout", "act.review_order", "act.place_order",
                                   "act.update_bag", "act.apply_voucher"]},
  "regions": {
    "results_list": "#results-list",
    "bag_subtotal": "#bag-subtotal",
    "bag_discount": "#bag-discount",
    "bag_voucher": "#bag-voucher",
    "bag_total": "#bag-total",
    "notice": "#notice",
    "confirm_method": "#confirm-method",
    "confirm_address": "#confirm-address",
    "confirm_total": "#confirm-total",
    "order_history": "#order-history"
  },
  "workflows": [
    {"name": "buy a lantern with standard delivery",
     "trace": [{"type": "CLICK", "id": "cat-lighting"}, {"type": "CLICK", "id": "product-lantern"},
               {"type": "CLICK", "id": "add-to-bag"}, {"type": "CLICK", "id": "go-checkout"},
               {"type": "TYPE", "id": "full-name", "params": {"category": "valid_typical"}},
               {"type": "TYPE", "id": "address", "params": {"category": "valid_typical"}},
               {"type": "CLICK", "id": "review-order"}, {"type": "CLICK", "id": "place-order"}],
     "expect": [{"region": "confirm_total", "contains": "27.95"},
                {"region": "confirm_address", "contains": "Test User Input"}]},
    {"name": "use the 10% voucher on a kettle",
     "trace": [{"type": "CLICK", "id": "cat-kitchen"}, {"type": "CLICK", "id": "product-kettle"},
               {"type": "CLICK", "id": "add-to-bag"},
               {"type": "SELECT", "id": "voucher", "params": {"option": "welcome10"}},
               {"type": "CLICK", "id": "apply-voucher"}],
     "expect": [{"region": "bag_discount", "contains": "3.60"}, {"region": "bag_total", "contains": "32.40"}]},
    {"name": "collect a hammock from the shop",
     "trace": [{"type": "CLICK", "id": "cat-outdoor"}, {"type": "CLICK", "id": "product-hammock"},
               {"type": "CLICK", "id": "add-to-bag"}, {"type": "CLICK", "id": "go-checkout"},
               {"type": "SELECT", "id": "method", "params": {"option": "collect"}},
               {"type": "CLICK", "id": "review-order"}, {"type": "CLICK", "id": "place-order"}],
     "expect": [{"region": "confirm_address", "contains": "14 Mill Lane"},
                {"region": "confirm_total", "contains": "44.00"}]},
    {"name": "search, then sort by price",
     "trace": [{"type": "TYPE", "id": "search-q", "params": {"category": "valid_typical"}},
               {"type": "CLICK", "id": "search-go"},
               {"type": "SELECT", "id": "sort", "params": {"option": "price-asc"}},
               {"type": "CLICK", "id": "apply-filters"}],
     "expect": [{"region": "results_list", "contains": "Linen tea towel from £8.50 Solar path lights"}],
     "commits": false},
    {"name": "choose the large lantern",
     "trace": [{"type": "CLICK", "id": "cat-lighting"}, {"type": "CLICK", "id": "product-lantern"},
               {"type": "SELECT", "id": "variant", "params": {"option": "large"}},
               {"type": "CLICK", "id": "add-to-bag"}],
     "expect": [{"region": "bag_subtotal", "contains": "32.00"}]},
    {"name": "buy, then find the order in the history",
     "trace": [{"type": "CLICK", "id": "cat-kitchen"}, {"type": "CLICK", "id": "product-tea-towel"},
               {"type": "CLICK", "id": "add-to-bag"}, {"type": "CLICK", "id": "go-checkout"},
               {"type": "TYPE", "id": "full-name", "params": {"category": "valid_typical"}},
               {"type": "TYPE", "id": "address", "params": {"category": "valid_typical"}},
               {"type": "CLICK", "id": "review-order"}, {"type": "CLICK", "id": "place-order"},
               {"type": "CLICK", "id": "all-orders"}],
     "expect": [{"region": "order_history", "contains": "12.45"}]}
  ],
  "state_dependent": [
    {"name": "Update bag changes the bag only after a quantity was edited",
     "useless": {"trace": [{"type": "CLICK", "id": "cat-lighting"}, {"type": "CLICK", "id": "product-lantern"},
                           {"type": "CLICK", "id": "add-to-bag"}],
                 "action": {"type": "CLICK", "id": "update-bag"}},
     "useful": {"trace": [{"type": "CLICK", "id": "cat-lighting"}, {"type": "CLICK", "id": "product-lantern"},
                          {"type": "CLICK", "id": "add-to-bag"},
                          {"type": "TYPE", "id": "qty-1", "params": {"category": "valid_typical"}}],
                "action": {"type": "CLICK", "id": "update-bag"}}},
    {"name": "Use voucher changes the bag only when a voucher is chosen",
     "useless": {"trace": [{"type": "CLICK", "id": "cat-kitchen"}, {"type": "CLICK", "id": "product-kettle"},
                           {"type": "CLICK", "id": "add-to-bag"}],
                 "action": {"type": "CLICK", "id": "apply-voucher"}},
     "useful": {"trace": [{"type": "CLICK", "id": "cat-kitchen"}, {"type": "CLICK", "id": "product-kettle"},
                          {"type": "CLICK", "id": "add-to-bag"},
                          {"type": "SELECT", "id": "voucher", "params": {"option": "welcome10"}}],
                "action": {"type": "CLICK", "id": "apply-voucher"}}}
  ],
  "decoys": [
    {"name": "Express checkout in the header", "trace": [], "decoy": {"type": "CLICK", "id": "express-checkout"}},
    {"name": "Gift options on the bag",
     "trace": [{"type": "CLICK", "id": "cat-lighting"}, {"type": "CLICK", "id": "product-lantern"},
               {"type": "CLICK", "id": "add-to-bag"}],
     "decoy": {"type": "CLICK", "id": "gift-options"}}
  ],
  "faults": [
    {
      "fault_id": "BAG-1",
      "fault_class": "calculation_error",
      "subtype": "stale-state",
      "oracle": "extension",
      "description": "The voucher discount is stored when it is applied and recomputed whenever an item is added or removed, but not when a quantity is changed with 'Update bag', so a percentage voucher keeps the discount it had for the old quantity.",
      "trigger_condition": "Put an item in the bag, apply the 10% voucher, then change the item's quantity and update the bag.",
      "expected_behaviour": "While the 10% voucher is applied, the bag's discount is always 10% of the items' total.",
      "observable_violation": "After raising the quantity to 42 the items total is £1,008.00 but the discount is still £2.40.",
      "assertions": [{"kind": "region_arithmetic", "where": "/bag$",
                      "expression": "discount == round(subtotal * 0.1, 2)",
                      "operands": {"discount": "bag_discount", "subtotal": "bag_subtotal"},
                      "guard": {"region": "bag_voucher", "contains": "10%"},
                      "describes": "a 10% voucher's discount equals 10% of the bag's items"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 0,
      "shortest_path": 7,
      "trigger_trace": [
        {"type": "CLICK", "id": "cat-lighting"}, {"type": "CLICK", "id": "product-lantern"},
        {"type": "CLICK", "id": "add-to-bag"},
        {"type": "SELECT", "id": "voucher", "params": {"option": "welcome10"}},
        {"type": "CLICK", "id": "apply-voucher"},
        {"type": "TYPE", "id": "qty-1", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "update-bag"}],
      "patch": {"file": "src/server.py",
                "find": "            refresh_voucher(conn, sid)  # the discount depends on what is in the bag\n",
                "replace": ""}
    },
    {
      "fault_id": "BAG-2",
      "fault_class": "state_corruption",
      "subtype": "displayed-vs-submitted",
      "oracle": "existing",
      "description": "The review page shows the delivery method the customer chose, but the 'Place order' form posts the shop's default method, so the order is placed (and charged) with standard delivery.",
      "trigger_condition": "Choose express delivery (or collection), complete the details, review, and place the order.",
      "expected_behaviour": "The order is placed with the delivery method the customer chose and saw on the review page.",
      "observable_violation": "The confirmation says standard delivery for an order the customer placed with express delivery.",
      "assertions": [
        {"kind": "echoes_input", "where": "/orders/BS-\\d+$", "region": "confirm_method", "input_field": "method",
         "describes": "the confirmed order carries the delivery method the customer chose"},
        {"kind": "text_absent", "where": "/orders/BS-\\d+$", "region": "notice", "expected": "BS-",
         "describes": "(scope) evaluated on the confirmation shown right after placing, not on a later revisit"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 1,
      "shortest_path": 9,
      "trigger_trace": [
        {"type": "CLICK", "id": "cat-lighting"}, {"type": "CLICK", "id": "product-lantern"},
        {"type": "CLICK", "id": "add-to-bag"}, {"type": "CLICK", "id": "go-checkout"},
        {"type": "SELECT", "id": "method", "params": {"option": "express"}},
        {"type": "TYPE", "id": "full-name", "params": {"category": "valid_typical"}},
        {"type": "TYPE", "id": "address", "params": {"category": "valid_typical"}},
        {"type": "CLICK", "id": "review-order"}, {"type": "CLICK", "id": "place-order"}],
      "patch": {"file": "src/pages.py",
                "find": "  <input type=\"hidden\" name=\"method\" value=\"{e(saved[\"method\"])}\">",
                "replace": "  <input type=\"hidden\" name=\"method\" value=\"{DEFAULT_METHOD}\">"}
    },
    {
      "fault_id": "BAG-3",
      "fault_class": "constraint_bypass",
      "subtype": "missing-validation",
      "oracle": "existing",
      "description": "The 'name and address required' check only applies to standard delivery; an express order goes through with no address at all.",
      "trigger_condition": "Choose express delivery, leave the address empty, review and place the order.",
      "expected_behaviour": "No delivered order is placed without a name and address.",
      "observable_violation": "The confirmation's delivery address is blank.",
      "assertions": [{"kind": "region_empty", "where": "/orders/BS-\\d+$", "region": "confirm_address",
                      "describes": "a confirmed order always shows where it is going (or the shop, for collection)"}],
      "reproduction": {"replays": 2, "must_all_reproduce": true},
      "observation_horizon": 1,
      "shortest_path": 7,
      "trigger_trace": [
        {"type": "CLICK", "id": "cat-lighting"}, {"type": "CLICK", "id": "product-lantern"},
        {"type": "CLICK", "id": "add-to-bag"}, {"type": "CLICK", "id": "go-checkout"},
        {"type": "SELECT", "id": "method", "params": {"option": "express"}},
        {"type": "CLICK", "id": "review-order"}, {"type": "CLICK", "id": "place-order"}],
      "patch": {"file": "src/server.py",
                "find": "            if chosen in (\"standard\", \"express\") and not (bag[\"full_name\"] and bag[\"address\"]):",
                "replace": "            if chosen == \"standard\" and not (bag[\"full_name\"] and bag[\"address\"]):"}
    }
  ],
  "benign_traces": [
    [{"type": "CLICK", "id": "cat-lighting"}, {"type": "CLICK", "id": "product-lantern"},
     {"type": "CLICK", "id": "add-to-bag"}, {"type": "CLICK", "id": "go-checkout"},
     {"type": "TYPE", "id": "full-name", "params": {"category": "valid_typical"}},
     {"type": "TYPE", "id": "address", "params": {"category": "valid_typical"}},
     {"type": "CLICK", "id": "review-order"}, {"type": "CLICK", "id": "place-order"}],
    [{"type": "CLICK", "id": "cat-kitchen"}, {"type": "CLICK", "id": "product-kettle"},
     {"type": "CLICK", "id": "add-to-bag"},
     {"type": "SELECT", "id": "voucher", "params": {"option": "welcome10"}},
     {"type": "CLICK", "id": "apply-voucher"}, {"type": "CLICK", "id": "nav-orders"}],
    [{"type": "CLICK", "id": "cat-lighting"}, {"type": "CLICK", "id": "product-lantern"},
     {"type": "SELECT", "id": "variant", "params": {"option": "large"}},
     {"type": "CLICK", "id": "add-to-bag"}, {"type": "CLICK", "id": "remove-1"}]
  ]
}
