{
  "app_id": "stackroom",
  "name": "Stackroom",
  "domain": "inventory administration (hardware wholesaler's stockroom)",
  "user_goal": "Sign in as a stock controller; find stock lines in a paged, filterable grid; restock or archive them in bulk; set stock levels inline or through the adjust page; review every change in the audit log.",
  "architecture": "data-grid+json-api(server-side paging)",
  "stack": "python-stdlib+pg8000+postgresql",
  "persistence": "postgresql schema per signed-in session (copied from a seeded template at sign-in); the grid's state lives in its query string (history.replaceState); column visibility is client-only",
  "entry": "/",
  "start": [
    "python",
    "src/server.py"
  ],
  "dockerfile": true,
  "database": {
    "engine": "postgres",
    "isolation": "schema-per-session",
    "schema": "src/schema.sql",
    "entities": [
      "users",
      "categories",
      "locations",
      "suppliers",
      "items",
      "journal",
      "purchase_orders",
      "order_lines"
    ],
    "auxiliary": [
      "counters",
      "notices"
    ],
    "references": [],
    "probes": [
      {
        "name": "an item in a category that does not exist",
        "kind": "foreign_key",
        "sql": "INSERT INTO items (sku, name, category_id, location_code, supplier_id, stock, reorder_level, status) VALUES ('SKU-900', 'Probe line', 'garden', 'A1', 'fixings', 1, 0, 'active')"
      },
      {
        "name": "a journal line by an unknown user",
        "kind": "foreign_key",
        "sql": "INSERT INTO journal (seq, stamp, sku, kind, before, after, origin, user_id) VALUES (99, '2026-06-10 09:00', 'SKU-101', 'stock', '12', '13', 'inline', 'nobody')"
      },
      {
        "name": "a negative stock level",
        "kind": "check",
        "sql": "UPDATE items SET stock = -1 WHERE sku = 'SKU-101'"
      },
      {
        "name": "an item status outside active/archived",
        "kind": "check",
        "sql": "UPDATE items SET status = 'lost' WHERE sku = 'SKU-102'"
      },
      {
        "name": "a second category named Fasteners",
        "kind": "unique",
        "sql": "INSERT INTO categories (id, name, position) VALUES ('fixings', 'Fasteners', 9)"
      }
    ],
    "absent_constraints": [
      {
        "fault_id": "STK-3",
        "constraint": "an audit trigger on items (AFTER UPDATE OF stock, inserting the journal line)",
        "reason": "every journal line is written by the application next to the change it records; a trigger would journal the inline save even when the application forgets to, so STK-3 could not exist"
      }
    ]
  },
  "login": {
    "path": "/login",
    "protected": [
      "/",
      "/stock",
      "/items/SKU-101",
      "/items/SKU-101/adjust",
      "/log"
    ],
    "public": [
      "/help/sign-in"
    ],
    "users": [
      {
        "username": "dev.malik",
        "name": "Dev Malik",
        "roles": [
          "controller"
        ],
        "macro": true
      },
      {
        "username": "lee.ward",
        "name": "Lee Ward",
        "roles": [
          "viewer"
        ]
      }
    ],
    "password_value": "Stackroom-aisle-26",
    "steps": [
      {
        "type": "TYPE",
        "id": "login-username",
        "params": {
          "value": "dev.malik"
        }
      },
      {
        "type": "TYPE",
        "id": "login-password",
        "params": {
          "value": "Stackroom-aisle-26"
        }
      },
      {
        "type": "CLICK",
        "id": "login-submit"
      }
    ],
    "form": {
      "action": "/login",
      "username_field": "username",
      "password_field": "password"
    },
    "signed_in_region": "signed_in_as",
    "error_region": "login_error",
    "sign_out": [
      {
        "type": "CLICK",
        "id": "nav-account"
      },
      {
        "type": "CLICK",
        "id": "sign-out"
      }
    ],
    "restricted": [
      {
        "user": "lee.ward",
        "path": "/items/SKU-101/adjust",
        "region": "access_notice"
      }
    ]
  },
  "workflow_graph": {
    "kind": [
      "data-grid",
      "hub-and-spoke"
    ],
    "nodes": [
      "sign-in",
      "sign-in-help",
      "stock-grid",
      "columns-menu",
      "item-adjust",
      "item-detail",
      "audit-log"
    ],
    "edges": [
